---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RtkStats from "@/components/site/RtkStats.astro";
import { APP_COUNT } from "@/data/apps";

const sections = [
  {
    href: "/start",
    eyebrow: "01",
    title: "Démarrer",
    desc: "Claude Code pour les vrais débutants. Pas de jargon, pas de spam d'agents/skills/hooks. Juste ce qu'il faut pour ouvrir le truc demain matin et comprendre ce que tu fais.",
    accent: true,
  },
  {
    href: "/theory",
    eyebrow: "02",
    title: "Théorie",
    desc: "Comment Claude Code fonctionne sous le capot — context window, tool use, sessions, hooks, slash commands, MCP, skills, agents SDK. À lire après le tuto.",
  },
  {
    href: "/atelier-ia",
    eyebrow: "03",
    title: "Atelier IA",
    desc: "Le vrai atelier multi-outils : Codex, Claude Code, Ollama, ChatGPT, OpenArt/DALL-E, Kombai, Cloudflare et GitHub. Qui sert à quoi, où sont les limites, et comment les faire coopérer.",
  },
  {
    href: "/ecosystem",
    eyebrow: "04",
    title: "Écosystème",
    desc: "Les plugins, skills, MCP servers et tools à connaître pour optimiser l'utilisation. Catalogue triable mis à jour chaque semaine.",
  },
  {
    href: "/case-studies",
    eyebrow: "05",
    title: "Case studies",
    desc: "Six apps perso codées en pair-programming avec Claude Code. Stack, archi, pièges rencontrés, leçons retenues.",
  },
  {
    href: "/learning",
    eyebrow: "06",
    title: "Learning",
    desc: "Les blogs et sites qui valent vraiment le détour pour suivre Claude et l'IA — Anthropic, Latent Space, Simon Willison, Every.to.",
  },
  {
    href: "/videos",
    eyebrow: "07",
    title: "Vidéos",
    desc: "Sélection de chaînes YouTube FR / EN qui couvrent Claude Code spécifiquement — pas de fluff, pas d'AI-influencer générique.",
  },
];
---

<BaseLayout
  title="claude-code-codex"
  description="Un codex non-officiel sur Claude Code : comment ça marche, l'écosystème, six apps construites avec, et les meilleures sources pour suivre l'évolution."
>
  <section class="relative codex-noise overflow-hidden">
    <!-- Hero zone : counter-mask the BaseLayout overlay so the cyberpunk
         video shows through brighter here than on content pages -->
    <div
      class="pointer-events-none absolute inset-0 bg-paper/-50 mix-blend-overlay"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 codex-grid opacity-25"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-claude/20 via-transparent to-transparent"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-paper"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-28">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-claude">
        Codex Claude Code · guides · projets
      </p>
      <h1
        class="mt-4 text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-ink leading-[1.05]"
      >
        Un codex pour comprendre, utiliser<br class="hidden md:inline" />
        et builder avec
        <span class="text-claude">Claude Code</span>.
      </h1>

      <div class="mt-6 flex items-center gap-3.5">
        <span
          class="grid place-items-center shrink-0 w-11 h-11 rounded-full border border-claude/50 bg-paper/80 font-mono text-sm text-claude"
          aria-hidden="true"
        >
          SL
        </span>
        <p class="text-base sm:text-lg text-ink leading-snug">
          Par <strong class="font-semibold">Sylvain Ladoire</strong> —
          développeur Java/web senior
          <span class="block text-sm text-ink-muted">
            {APP_COUNT} applications construites avec Claude Code, déployées
            sur Kubernetes + GitOps
          </span>
        </p>
      </div>

      <p class="mt-5 max-w-2xl text-base sm:text-lg text-ink-muted leading-relaxed">
        Débutant sur Claude Code&nbsp;? <strong class="text-ink">Commence par le tuto</strong>.
        Recruteur ou développeur pressé&nbsp;? Va droit aux projets et aux
        guides Kubernetes.
      </p>

      <!-- Rangée de boutons : flex-wrap, chaque bouton autonome (min 44 px) —
           un bouton de plus s'ajoute ici sans reprise de mise en page. -->
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/start"
          class="inline-flex items-center gap-2 min-h-11 px-5 py-2.5 rounded-md bg-claude text-paper font-medium hover:bg-claude-soft transition-colors motion-safe:active:scale-95"
        >
          Démarrer (débutants) →
        </a>
        <a
          href="/case-studies"
          class="inline-flex items-center gap-2 min-h-11 px-5 py-2.5 rounded-md border border-white/15 bg-paper/80 text-ink hover:bg-paper-elevated transition-colors motion-safe:active:scale-95"
        >
          Voir les projets →
        </a>
        <a
          href="https://github.com/Sylad"
          target="_blank"
          rel="noopener"
          title="Profil GitHub de Sylvain Ladoire — pour me contacter"
          aria-label="GitHub ↗ — profil de Sylvain Ladoire, pour me contacter (nouvel onglet)"
          class="inline-flex items-center gap-2 min-h-11 px-5 py-2.5 rounded-md border border-claude/40 bg-paper/80 text-claude hover:bg-paper-elevated transition-colors motion-safe:active:scale-95"
        >
          GitHub ↗
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-muted mb-10">
      Sommaire
    </p>
    <div class="grid gap-px bg-white/5 rounded-xl overflow-hidden border border-white/10">
      {sections.map((s) => (
        <a
          href={s.href}
          class={`group flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 p-6 sm:p-8 transition-colors motion-safe:active:scale-[0.995] ${s.accent ? "bg-claude/5 hover:bg-claude/10" : "bg-paper hover:bg-paper-elevated"}`}
        >
          <span class="font-mono text-sm text-claude w-12 shrink-0">
            {s.eyebrow}
          </span>
          <div class="flex-1">
            <h2 class="text-xl sm:text-2xl font-medium text-ink group-hover:text-claude transition-colors">
              {s.title}
              {s.accent && (
                <span class="ml-2 align-middle inline-block font-mono text-[10px] uppercase tracking-wider text-claude border border-claude/40 rounded px-1.5 py-0.5">
                  Commence ici
                </span>
              )}
            </h2>
            <p class="mt-2 text-ink-muted leading-relaxed max-w-2xl">
              {s.desc}
            </p>
          </div>
          <span class="font-mono text-ink-muted group-hover:text-claude motion-safe:group-hover:translate-x-2 transition-all duration-200">
            →
          </span>
        </a>
      ))}
    </div>
  </section>

  <RtkStats />

  <section class="mx-auto max-w-4xl px-5 sm:px-8 py-12">
    <div
      class="rounded-xl border border-claude/20 bg-claude/5 p-6 sm:p-8 text-center"
    >
      <p class="text-sm font-mono uppercase tracking-wider text-claude mb-3">
        Note de l'auteur
      </p>
      <p class="text-ink leading-relaxed">
        Site fan, sans affiliation Anthropic. Sources publiques uniquement.
        Si tu spottes une erreur, ouvre une issue
        <a
          class="text-claude hover:text-claude-soft underline underline-offset-4"
          href="https://github.com/Sylad/claude-code-codex"
          target="_blank"
          rel="noopener"
        >
          sur le repo
        </a>.
      </p>
    </div>
  </section>
</BaseLayout>
