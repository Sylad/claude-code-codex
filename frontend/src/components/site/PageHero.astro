---
// L8 : un `code` cité dans l'intro devient un vrai <code> (plus d'accents graves bruts).
import { inlineCodeHtml } from "@/lib/inline-code.mjs";

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="relative codex-grid border-b border-white/5">
  <div class="mx-auto max-w-6xl px-[min(1.25rem,20px)] sm:px-8 py-20 sm:py-28">
    <p class="inline-block rounded bg-paper/85 px-2 py-1 font-mono text-xs uppercase tracking-[0.2em] text-claude-soft">
      {eyebrow}
    </p>
    <h1 class="mt-3 text-[length:min(2.25rem,max(1.375rem,12vw))] max-sm:leading-(--text-4xl--line-height) sm:text-5xl font-semibold tracking-tight text-ink [overflow-wrap:anywhere]">
      {title}
    </h1>
    {intro && (
      <p
        class="mt-5 max-w-2xl text-base sm:text-lg text-ink leading-relaxed [text-shadow:0_1px_3px_rgb(0_0_0_/0.85)] [&_code]:font-mono [&_code]:text-[0.9em]"
        set:html={inlineCodeHtml(intro)}
      />
    )}
  </div>
</section>
