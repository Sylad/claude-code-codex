---
import Schema from "@/components/site/Schema.astro";
// L108 — schéma « le lead et ses créneaux » de l'étude cadence (L33), partagé par la page française et sa
// traduction (/en/) : le dessin ici, les textes en props (déplacé sans changement).
interface Bloc { qui: string; titre: string; detail: string }
interface Props {
  data: {
    haut: Bloc;
    creneaux: { titre: string; code: string; detail: string; accent?: boolean }[];
    bas: Bloc;
    boucle: string;
  };
  titre: string;
  desc: string;
  legende: string;
}
const { data, titre, desc, legende } = Astro.props;
---

<Schema id="lead-creneaux" legende={legende}>
  <svg viewBox="0 0 420 340" role="img" aria-labelledby="sch-lead-creneaux-t sch-lead-creneaux-d" xmlns="http://www.w3.org/2000/svg">
    <title id="sch-lead-creneaux-t">{titre}</title>
    <desc id="sch-lead-creneaux-d">{desc}</desc>
    <rect class="sch-box" x="16" y="12" width="388" height="78" rx="10" />
    <text class="sch-a" x="30" y="34">{data.haut.qui}</text>
    <text class="sch-t" x="30" y="56">{data.haut.titre}</text>
    <text class="sch-m" x="30" y="76">{data.haut.detail}</text>
    {data.creneaux.map((c, i) => (
      <>
        <line class="sch-line" x1={109 + 202 * i} y1="90" x2={109 + 202 * i} y2="112" />
        <path class="sch-arrow" d={`M${103 + 202 * i} 110 L${115 + 202 * i} 110 L${109 + 202 * i} 120 Z`} />
        <rect class={c.accent ? "sch-box-accent" : "sch-box"} x={16 + 202 * i} y="122" width="186" height="96" rx="10" />
        <text class="sch-t" x={30 + 202 * i} y="146">{c.titre}</text>
        <text class={i === 0 ? "sch-m sch-mono" : "sch-m"} x={30 + 202 * i} y="170">{c.code}</text>
        <text class="sch-m" x={30 + 202 * i} y="192">{c.detail}</text>
      </>
    ))}
    <line class="sch-line" x1="109" y1="218" x2="109" y2="240" />
    <path class="sch-arrow" d="M103 238 L115 238 L109 248 Z" />
    <path class="sch-line-accent" d="M311 250 V230" />
    <path class="sch-arrow-accent" d="M305 230 L317 230 L311 220 Z" />
    <rect class="sch-box-accent" x="16" y="250" width="388" height="78" rx="10" />
    <text class="sch-a" x="30" y="272">{data.bas.qui}</text>
    <text class="sch-t" x="30" y="294">{data.bas.titre}</text>
    <text class="sch-m" x="30" y="314">{data.bas.detail}</text>
  </svg>
  <div class="sch-liste" data-sch-liste="lead-creneaux">
    <ul class="sch-suite" aria-label={titre}>
      <li class="sch-etape">
        <span class="sch-qui">{data.haut.qui}</span>
        <span class="sch-titre">{data.haut.titre}</span>
        <span class="sch-detail">{data.haut.detail}</span>
      </li>
      <li class="sch-etape">
        <ul class="sch-sous">
          {data.creneaux.map((c, i) => (
            <li class={c.accent ? "sch-etape-accent" : undefined}>
              <span class="sch-titre">{c.titre}</span>
              <span class:list={["sch-detail", { "sch-mono": i === 0 }]}>{c.code}</span>
              <span class="sch-detail">{c.detail}</span>
            </li>
          ))}
        </ul>
      </li>
      <li class="sch-etape sch-etape-accent">
        <span class="sch-qui">{data.bas.qui}</span>
        <span class="sch-titre">{data.bas.titre}</span>
        <span class="sch-detail">{data.bas.detail}</span>
      </li>
    </ul>
    <p class="sch-boucle"><span aria-hidden="true">↺ </span>{data.boucle}</p>
  </div>
</Schema>
