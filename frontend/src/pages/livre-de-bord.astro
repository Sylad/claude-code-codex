---
/*
  L44 — Livre de bord : une entrée par semaine sur le développement avec l'IA — ce que nous
  avons appris, ce que nous fabriquons, ce que nous avons testé. Contenu : data/livre-de-bord.ts
  (la plus récente en premier), filtré AU BUILD par lib/livre-de-bord.ts : un contenu privé,
  un lien vers une page qui n'existe pas ou une entrée mal datée fait échouer le build.
*/
import { readdirSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ENTRIES } from "@/data/livre-de-bord";
import { findProblems, entryId, paragraphs, type BookItem } from "@/lib/livre-de-bord";
import { SCHEMAS } from "@/data/livre-de-bord-schemas";
import BookSchema from "@/components/site/BookSchema.astro";
import { formatDay } from "@/lib/format-date.mjs";

// Le build se lance depuis frontend/ : les pages sont à src/pages.
const pages = readdirSync(join(process.cwd(), "src", "pages"), { recursive: true })
  .map(String)
  .filter((f) => f.endsWith(".astro"))
  .map((f) => `/${f.replace(/\.astro$/, "").replace(/(^|\/)index$/, "")}`);
const problems = findProblems(ENTRIES, (path) => pages.includes(path), Object.keys(SCHEMAS));
if (problems.length > 0) {
  throw new Error(`Livre de bord non publiable :\n- ${problems.join("\n- ")}`);
}

const rubriques: { key: "appris" | "fabrique" | "teste"; title: string }[] = [
  { key: "appris", title: "Ce que nous avons appris" },
  { key: "fabrique", title: "Ce que nous fabriquons" },
  { key: "teste", title: "Ce que nous avons testé" },
];
const rubriqueTitle = (e: (typeof ENTRIES)[number], key: "appris" | "fabrique" | "teste", fallback: string) =>
  e.rubriques?.[key] ?? fallback;
const external = (href: string) => href.startsWith("https://");
---

<BaseLayout
  title="Livre de bord"
  description="Une entrée par semaine sur le développement avec l'IA : ce que nous avons appris, les outils que nous fabriquons, les outils que nous avons testés."
>
  <section class="book-hero relative codex-grid border-b border-white/5">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-28">
      <p class="book-eyebrow inline-block rounded bg-paper/85 px-2 py-1 font-mono text-xs uppercase tracking-[0.2em] text-claude-soft">
        Développement avec l’IA
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-ink">
        Livre de bord
      </h1>
      <p class="book-lede mt-5 max-w-2xl text-base sm:text-lg text-ink leading-relaxed">
        Une entrée par semaine sur le développement avec l’IA : les pertes de temps
        et le mécanisme qui les a supprimées, les outils que nous fabriquons, ceux que
        nous avons testés. Seul ce qui est public y figure.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-5 sm:px-8 py-16">
    <nav aria-label="Les semaines" class="book-weeks mb-8 rounded-lg border border-white/10 bg-paper-elevated px-4 py-3 text-sm">
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {ENTRIES.map((e) => (
          <li>
            <a class="inline-flex items-center min-h-11 text-claude-soft underline underline-offset-4 hover:text-ink" href={`#${entryId(e)}`}>
              {e.theme ? `Semaine ${e.semaine.slice(-2)} · thème` : `Semaine ${e.semaine.slice(-2)}`}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {ENTRIES.map((e) => (
      <article class="book-entry mb-8 rounded-xl border border-white/10 bg-paper-elevated p-6 sm:p-8" id={entryId(e)} data-semaine={e.semaine} aria-labelledby={`titre-${entryId(e)}`}>
        <h2 id={`titre-${entryId(e)}`} class="text-xl sm:text-2xl font-semibold text-ink">
          {e.theme ?? `Semaine ${e.semaine.slice(-2)}`}
        </h2>
        <p class="mt-1 font-mono text-sm text-ink-muted">
          {e.theme && <span>Semaine {e.semaine.slice(-2)} · </span>}<time datetime={e.date} class="whitespace-nowrap">{formatDay(e.date)}</time>
        </p>
        <p class="mt-4 text-ink leading-relaxed">{e.resume}</p>
        {e.schema && <BookSchema id={e.schema} />}

        {rubriques.map((r) => (
          <section class="mt-8" aria-labelledby={`${r.key}-${entryId(e)}`}>
            <h3 id={`${r.key}-${entryId(e)}`} class="text-lg font-semibold text-ink">{rubriqueTitle(e, r.key, r.title)}</h3>
            <ul class="mt-3">
              {(e[r.key] as BookItem[]).map((it) => (
                <li class="book-item border-t border-white/10 py-4">
                  <p class="font-medium text-ink leading-snug [overflow-wrap:anywhere]">{it.titre}</p>
                  {paragraphs(it.texte).map((p) => (
                    <p data-para class="mt-1.5 text-ink-muted leading-relaxed">{p}</p>
                  ))}
                  {it.illustration && <BookSchema id={it.illustration} />}
                  {it.liens && it.liens.length > 0 && (
                    <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                      {it.liens.map((l) => (
                        <a
                          class="inline-flex items-center min-h-11 text-claude-soft underline underline-offset-4 hover:text-ink"
                          href={l.href}
                          target={external(l.href) ? "_blank" : undefined}
                          rel={external(l.href) ? "noopener" : undefined}
                        >
                          {l.label}
                        </a>
                      ))}
                    </p>
                  )}
                </li>
              ))}
              {e[r.key].length === 0 && (
                <li class="book-item border-t border-white/10 py-4 italic text-ink-muted">Rien de nouveau cette semaine.</li>
              )}
            </ul>
          </section>
        ))}
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  /* En-tête posé sur l'image de fond : même ombre portée que Plan de travail. */
  .book-hero .book-eyebrow,
  .book-hero h1,
  .book-hero .book-lede {
    text-shadow: 0 0 2px rgb(0 0 0 / 0.9), 0 1px 3px rgb(0 0 0 / 0.85);
  }
  /* Les liens de la barre des semaines laissent le titre d'une entrée visible sous l'en-tête fixe du site. */
  .book-entry {
    scroll-margin-top: 5rem;
  }
  .book-entry a:focus-visible,
  .book-weeks a:focus-visible {
    outline: 2px solid var(--color-claude);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
