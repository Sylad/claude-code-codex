---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="relative codex-grid border-b border-white/5">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-28">
    <p class="inline-block rounded bg-paper/85 px-2 py-1 font-mono text-xs uppercase tracking-[0.2em] text-claude-soft">
      {eyebrow}
    </p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-ink [overflow-wrap:anywhere]">
      {title}
    </h1>
    {intro && (
      <p class="mt-5 max-w-2xl text-base sm:text-lg text-ink leading-relaxed [text-shadow:0_1px_3px_rgb(0_0_0_/0.85)]">
        {intro}
      </p>
    )}
  </div>
</section>
