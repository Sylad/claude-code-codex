---
interface Props {
  language: string;
  filename?: string;
  code: string;
  /** Texte en prose (un prompt) : revient à la ligne au lieu de défiler de côté. */
  wrap?: boolean;
}

const { language, filename, code, wrap = false } = Astro.props;
---

<figure class="rounded-lg border border-white/10 bg-paper overflow-hidden my-4">
  <figcaption
    class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-[min(1rem,16px)] py-2 border-b border-white/5 bg-white/[0.02]"
  >
    {/* L88 — le nom garde au moins 12 caractères de large (en ch : la mesure suit la taille du texte) ;
         quand la langue ne tient plus à côté (texte agrandi au téléphone), elle passe à la ligne au lieu
         d'écraser le nom jusqu'à couper ses mots (« promp|t », « Équivalen|t »). Au réglage normal, rien
         ne bouge : 12 caractères et la langue tiennent dès 320 px. */}
    <span class="grow basis-0 min-w-[min(100%,12ch)] font-mono text-xs text-ink-muted">
      {filename ?? `[${language}]`}
    </span>
    <span class="shrink-0 whitespace-nowrap font-mono text-xs uppercase tracking-wider text-claude">
      {language}
    </span>
  </figcaption>
  <pre
    tabindex={wrap ? undefined : "0"}
    role={wrap ? undefined : "region"}
    aria-label={wrap ? undefined : `Code : ${filename ?? language}`}
    class:list={["px-[min(1rem,16px)] py-3 text-sm leading-relaxed font-mono text-ink/90 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-claude", wrap ? "whitespace-pre-wrap break-words" : "overflow-x-auto"]}><code>{code}</code></pre>
</figure>
