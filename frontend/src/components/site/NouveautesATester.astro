---
// L35 — « Nouveautés à tester » : ce que la veille hebdomadaire a relevé dans anthropics/skills et
// modelcontextprotocol/servers (src/data/feeds/*.json) et qui n'est pas encore au catalogue.
// Rien d'inventé : nom, lien, date de relevé et extrait viennent du flux (src/lib/nouveautes-a-tester.mjs).
import skills from "@/data/feeds/github-anthropics-skills.json";
import mcpServers from "@/data/feeds/github-mcp-servers.json";
import releves from "@/data/feeds/derniers-releves.json";
import { ecosystemEntries } from "@/data/ecosystem";
import { fluxATester } from "@/lib/nouveautes-a-tester.mjs";
import DateLongue from "./DateLongue.astro";

const flux = [
  fluxATester("github-anthropics-skills", skills, ecosystemEntries, releves),
  fluxATester("github-mcp-servers", mcpServers, ecosystemEntries, releves),
];
const unite = (f: (typeof flux)[number], n: number) =>
  f.nature === "skill" ? (n > 1 ? "skills relevées" : "skill relevée") : n > 1 ? "serveurs relevés" : "serveur relevé";
---

<section
  class="mx-auto max-w-6xl px-borne-5 sm:px-8 pt-10"
  aria-labelledby="a-tester-titre"
  data-a-tester
>
  <p class="font-mono text-xs uppercase tracking-wider text-claude mb-3">Veille hebdomadaire</p>
  <h2 id="a-tester-titre" class="text-2xl font-medium text-ink mb-3">Nouveautés à tester</h2>
  <p class="text-ink-muted leading-relaxed max-w-3xl mb-6">
    Ce que le relevé automatique des dépôts officiels a trouvé et qui n'est pas encore dans le
    catalogue ci-dessus. Pas encore testé : chaque entrée renvoie à sa source.
  </p>
  <div class="grid gap-6 md:grid-cols-2">
    {flux.map((f) => (
      <div
        class="rounded-lg border border-white/10 bg-paper-elevated p-borne-4 [overflow-wrap:anywhere]"
        data-flux={f.cle}
      >
        <h3 class="text-base font-medium text-ink">
          {f.libelle} ·{" "}
          <a href={f.depot.href} target="_blank" rel="noopener" class="text-claude underline underline-offset-4">{f.depot.label}</a>
        </h3>
        <p class="mt-1 font-mono text-xs text-ink-muted" data-releve>
          {f.releve ? (
            <>Dernier relevé le <DateLongue day={f.releve} /> · {f.total} {unite(f, f.total)}</>
          ) : f.derniereNouveaute ? (
            <>Dernière nouveauté relevée le <DateLongue day={f.derniereNouveaute} /> · {f.total} {unite(f, f.total)}</>
          ) : (
            <>Aucun relevé pour l'instant</>
          )}
        </p>
        {f.aTester.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted" data-rien>
            {f.total > 0 ? "Tout ce qui a été relevé est déjà au catalogue." : "Rien à montrer."}
          </p>
        ) : (
          <ul class="mt-3 grid gap-3">
            {f.aTester.map((n) => (
              <li class="border-t border-white/10 pt-3" data-a-tester-entree>
                <h4 class="font-mono text-sm text-ink">{n.nom}</h4>
                {n.extrait && (
                  <p class="mt-1 text-sm text-ink-muted leading-relaxed" lang={n.extrait.langue}>{n.extrait.texte}</p>
                )}
                <p class="mt-2 text-sm">
                  <a href={n.lien} target="_blank" rel="noopener" class="text-claude underline underline-offset-4">Voir {n.nom} sur GitHub</a>
                  <span class="text-ink-muted"> · relevé le <DateLongue day={n.releve} /></span>
                </p>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</section>
