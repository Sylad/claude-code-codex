---
/*
  L15 — Plan de travail : ce qui est en cours, prévu et récemment livré sur le site
  (repris d'evatosorus L28, lui-même inspiré de la page « À venir » d'AetherWX).

  Source : docs/plan/raf.yaml (tenu par raf, cadence), lu AU BUILD. On ne publie que
  les lots visibles qui ont un TITRE PUBLIC (champ public: du plan ; pour un lot livré,
  à défaut, le titre de sa Nouveauté ; jamais le titre brut), avec leur état et le
  décompte de leurs sous-tâches (liste blanche de lib/plan-public.ts) : titres bruts,
  notes, verdicts UX et raisons d'abandon ne sont jamais rendus
  (tests/plan-page.e2e.test.mjs le vérifie sur tout dist/). Plan absent ou illisible,
  titre public non conforme : le build échoue.
*/
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDay } from "@/lib/format-date.mjs";
import { parsePublicPlan, planSummary, stepsLabel, RECENT_DONE, type PublicLot } from "@/lib/plan-public";
import news from "../../public/nouveautes-data/nouveautes.json";

// Le build se lance depuis frontend/ (npm run build ; Cloudflare Pages : « cd frontend &&
// npm install && npm run build ») : le plan est à ../docs/plan/raf.yaml. Un seul chemin ;
// absent, le build échoue.
const rafPath = join(process.cwd(), "..", "docs", "plan", "raf.yaml");
if (!existsSync(rafPath)) {
  throw new Error(`plan introuvable : ${rafPath} — le build doit se lancer depuis frontend/ (cd frontend && npm run build)`);
}
const plan = parsePublicPlan(readFileSync(rafPath, "utf8"), news.entries);

const summary = planSummary(plan.counts);

interface Section {
  id: string;
  title: string;
  intro: string;
  lots: PublicLot[];
  empty: string;
  news?: boolean;
}
const sections: Section[] = [
  { id: "en-cours", title: "En cours", intro: "Ce qui est sur l’établi en ce moment.", lots: plan.doing, empty: "Rien en cours pour l’instant." },
  { id: "prevu", title: "Prévu", intro: "La suite, dans l’ordre du plan.", lots: plan.todo, empty: "Les prochains travaux seront annoncés ici." },
  {
    id: "livre",
    title: "Récemment livré",
    intro: plan.counts.done > RECENT_DONE
      ? `Les ${RECENT_DONE} derniers travaux terminés sur ${plan.counts.done}, racontés en détail dans les`
      : "Les derniers travaux terminés, racontés en détail dans les",
    news: true,
    lots: plan.done,
    empty: "Rien de livré pour l’instant.",
  },
];
---

<BaseLayout
  title="Plan de travail"
  description="Ce qui se prépare sur claude-code-codex : travaux en cours, prévus et récemment livrés."
>
  <section class="plan-hero relative codex-grid border-b border-white/5">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-28">
      <p class="plan-eyebrow inline-block rounded bg-paper/85 px-2 py-1 font-mono text-xs uppercase tracking-[0.2em] text-claude-soft">
        Plan de travail
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-ink">
        Ce qui se prépare
      </h1>
      <p class="plan-lede mt-5 max-w-2xl text-base sm:text-lg text-ink leading-relaxed [text-shadow:0_1px_3px_rgb(0_0_0_/0.85)]">
        Les travaux en cours, ceux qui suivent et ceux qui viennent d’être terminés,
        mis à jour à chaque publication du site.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-5 sm:px-8 py-16">
    {summary.length > 0 && (
      <p class="plan-summary mb-8 flex flex-wrap gap-x-5 gap-y-1 rounded-lg border border-white/10 bg-paper-elevated px-4 py-3 font-mono text-sm text-ink">
        {summary.map((part) => <span>{part}</span>)}
      </p>
    )}

    {sections.map((s) => (
      <section class="plan-section mb-8 rounded-xl border border-white/10 bg-paper-elevated p-6 sm:p-8" aria-labelledby={`plan-${s.id}`}>
        <h2 id={`plan-${s.id}`} class="text-xl sm:text-2xl font-semibold text-ink">{s.title}</h2>
        <p class="plan-intro mt-2 text-ink-muted leading-relaxed">
          {s.intro}
          {s.news && <Fragment> <a href="/nouveautes" class="text-claude-soft underline underline-offset-4 hover:text-ink">Nouveautés</a>.</Fragment>}
        </p>
        {s.lots.length === 0 ? (
          <p class="plan-empty mt-5 italic text-ink-muted">{s.empty}</p>
        ) : (
          <ol class="plan-list mt-5">
            {s.lots.map((l) => (
              <li class="plan-lot border-t border-white/10 py-4" data-status={l.status} data-id={l.id} id={`lot-${l.id}`} data-also={l.also?.join(" ")}>
                <p class="plan-lot-title text-base sm:text-lg text-ink leading-snug [overflow-wrap:anywhere]">{l.title}</p>
                {(l.finished || l.tasks) && (
                  <p class="plan-lot-meta mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-sm text-ink-muted">
                    {l.finished && <time datetime={l.finished} class="whitespace-nowrap">{formatDay(l.finished)}</time>}
                    {l.tasks && <span class="plan-tasks whitespace-nowrap">{stepsLabel(l.tasks)}</span>}
                  </p>
                )}
              </li>
            ))}
          </ol>
        )}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  /* En-tête posé sur l'image de fond : ombre portée pour tenir 4,5:1 au pire pixel
     (mesuré par tests/plan-page.e2e.test.mjs). */
  .plan-hero .plan-eyebrow,
  .plan-hero h1,
  .plan-hero .plan-lede {
    text-shadow: 0 0 2px rgb(0 0 0 / 0.9), 0 1px 3px rgb(0 0 0 / 0.85);
  }
  .plan-intro a:focus-visible {
    outline: 2px solid var(--color-claude);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
