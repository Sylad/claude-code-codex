---
interface Props {
  eyebrow: string;
  /** Ancre facultative (lien direct vers un chapitre, L93). */
  id?: string;
}

const { eyebrow, id } = Astro.props;
---

<article id={id} class="space-y-4 scroll-mt-20">
  <h2 class="font-mono text-xs font-normal uppercase tracking-[0.2em] text-claude">
    {eyebrow}
  </h2>
  <div class="text-ink leading-relaxed space-y-4 [&>p]:leading-relaxed [&_strong]:text-ink [&_a]:text-claude [&_a:hover]:text-claude-soft [&_a]:underline [&_a]:underline-offset-4">
    <slot />
  </div>
</article>
