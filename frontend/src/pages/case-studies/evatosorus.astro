---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import MermaidDiagram from "@/components/site/MermaidDiagram.vue";
import CaseStudySection from "@/components/site/CaseStudySection.astro";
import EtudeFraicheur from "@/components/site/EtudeFraicheur.astro";
import ChiffreDate from "@/components/site/ChiffreDate.astro";

// L39 — état relu le 17 novembre 2026 dans le dépôt evatosorus : README, CLAUDE.md, HOW-IT-WORKS.md,
// historique git, frontend/package.json, src/data/generated/species.generated.json (count = 1500).
const DATE_ETUDE = "2026-11-17";
// Relevé : nombre de fichiers HTML de frontend/dist après le build du 17-11-2026.
const nbPages: number | undefined = 1533;
---

<BaseLayout
  title="Case study · Evatosorus"
  description="Codex paléontologique offert à une proche, suite d'Eywa : 1 500 espèces du Mésozoïque importées de PaleoBioDB et enrichies hors ligne, carte des fossiles, films, vidéos openart.ai. Astro 7 statique sur Cloudflare Pages."
>
  <PageHero
    eyebrow="Case study · evatosorus"
    title="Evatosorus"
    intro="Codex paléontologique — suite d'Eywa (même destinataire, même pattern Astro, identité opposée). 1 500 espèces du Mésozoïque importées de PaleoBioDB, enrichies hors ligne par une IA locale, une carte des fossiles, les films Jurassic Park comme porte d'entrée, des vidéos générées sur openart.ai. Ton documentaire BBC, palette ambre / sable / terre, build statique pur sur Cloudflare Pages."
  />

  <section class="mx-auto max-w-3xl px-5 sm:px-8 py-12">
    <div class="space-y-12">
      <EtudeFraicheur depots={["evatosorus"]} date={DATE_ETUDE} />

      <CaseStudySection eyebrow="Le pitch">
        <p>
          La même destinataire avait déjà reçu Eywa (codex Avatar / Pandora).
          Pour le deuxième round, on monte d'un cran : un
          <strong>codex paléontologique du Mésozoïque tout entier</strong> —
          Trias, Jurassique, Crétacé. Voyage temporel, carte des fossiles
          trouvés, fiches illustrées. Bonus vanne maison : qui a déjà vu Avatar
          douze fois ne refusera pas un T-Rex en plein écran.
        </p>
        <p>
          Mêmes briques que Eywa (Astro, React, Tailwind), même pattern codex,
          mais identité visuelle <strong>opposée</strong> : là où Eywa est cyan
          / bioluminescent / océan, Evatosorus tape dans l'ambre / sable / terre
          / fossile. Pas de duplication UX verbatim — anti-pattern explicite du
          projet. Live :
          <a href="https://evatosorus.pages.dev" target="_blank" rel="noopener">evatosorus.pages.dev</a>
          · code :
          <a href="https://github.com/Sylad/evatosorus" target="_blank" rel="noopener">github.com/Sylad/evatosorus</a>.
        </p>
      </CaseStudySection>

      <CaseStudySection eyebrow="Architecture">
        <p>
          Aucun backend. Aucun NAS. Toutes les données sont préparées en local
          par des scripts Node, committées, puis figées au build : le build
          Cloudflare ne fait aucun appel réseau.
        </p>
        <ChiffreDate
          valeur={nbPages}
          unite="pages HTML"
          libelleAbsent="Nombre de pages"
          date={DATE_ETUDE}
          source="frontend/dist"
          pourquoi="le site n'avait pas été construit"
        />

        <MermaidDiagram
          client:visible
          caption="Préparation en local (import PaleoBioDB, enrichissement Wikidata / Wikipédia / IA locale, images Commons), puis Astro 7 statique sur Cloudflare Pages."
          definition={`flowchart TB
  subgraph LOCAL["Préparation en local (scripts Node)"]
    imp["import-paleobiodb.mjs — 1 500 espèces + occurrences"]
    enr["enrich-species.mjs — cache par espèce, reprise possible"]
  end

  subgraph SRC["Sources publiques"]
    pbdb["PaleoBioDB — taxonomie, occurrences, datations"]
    wd["Wikidata + Wikipédia — nom, classification, régime"]
    wmc["Wikimedia Commons — images sous licence libre"]
    llm["llama 3.1 via Ollama (local) — blurbs reformulés"]
  end

  subgraph REPO["Dépôt evatosorus (committé)"]
    seed["species.seed.ts — 24 espèces curées, prioritaires"]
    gen["species.generated.json + images locales"]
    mp4["Vidéos openart.ai (chacune sous 25 MB)"]
  end

  subgraph FE["Astro 7 (statique pur)"]
    pages["Accueil, codex, périodes, fiches, films, carte, vitrines, comprendre, vidéos"]
    islands["Îlots React 19 — CodexBrowser, PaleoMap (Leaflet)"]
  end

  CF["Cloudflare Pages — evatosorus.pages.dev"]

  imp --> pbdb
  enr --> wd
  enr --> wmc
  enr --> llm
  imp --> gen
  enr --> gen
  seed --> pages
  gen --> pages
  mp4 --> pages
  pages --> islands
  pages -->|push main, build auto| CF`}
        />
      </CaseStudySection>

      <CaseStudySection eyebrow="Données — 1 500 espèces du Mésozoïque">
        <p>
          La source principale est l'<a
            href="https://paleobiodb.org/data1.2/"
            target="_blank"
            rel="noopener">API PaleoBioDB</a
          > — gratuite, taxonomie exhaustive avec occurrences fossiles datées.
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">import-paleobiodb.mjs</code>
          écrit un JSON de 1 500 espèces, fusionné au build avec un
          <strong>seed manuel</strong> de 24 espèces stars (T-Rex,
          Vélociraptor, Brachiosaurus, Spinosaurus…). Le seed reste la source
          de vérité : toute régénération fusionne, n'écrase jamais.
        </p>
        <p>
          Importer 1 500 espèces donnait des fiches creuses. Fin mai 2026,
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">enrich-species.mjs</code>
          les a remplies : nom commun, classification et régime depuis
          Wikidata et Wikipédia, un résumé reformulé en ton documentaire par
          <strong>llama 3.1 qui tourne en local</strong> (aucun service tiers),
          et une image Wikimedia Commons téléchargée et créditée. Le run de
          référence : 1 422 fiches enrichies sur 1 479, 976 images, zéro
          erreur. Les fiches restées sans image gardent un visuel par défaut
          propre plutôt qu'un trou.
        </p>
        <p>
          La carte des fossiles (Leaflet avec regroupement des points, fond
          Esri World Dark Gray Base) place les occurrences PaleoBioDB, colorées
          par période. C'est un îlot React monté en
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">client:only="react"</code>
          — Leaflet ne survit pas au rendu serveur.
        </p>
      </CaseStudySection>

      <CaseStudySection eyebrow="Les films comme porte d'entrée">
        <p>
          La destinataire n'est pas paléontologue, elle est cinéphile. D'où le
          pari : plutôt qu'un index académique, on entre aussi dans le codex
          <strong>par les films Jurassic Park</strong>. Chaque film a sa fiche,
          et chaque espèce vedette renvoie vers sa propre fiche détaillée. Un
          visiteur qui ne connaît rien aux dinosaures part du T-Rex de 1993 et
          dérive vers des espèces du Crétacé qu'il n'a jamais vues à l'écran.
        </p>
        <p>
          Depuis, d'autres portes se sont ajoutées : une page
          <strong>Vitrines</strong> (« Le musée vivant commence ici ») pour
          les espèces stars, une page <strong>Comprendre</strong> qui explique
          ce qu'est un dinosaure, une frise des périodes et une page de chaînes
          vidéo. Le codex complet reste filtrable et paginé par 60.
        </p>
      </CaseStudySection>

      <CaseStudySection eyebrow="Vidéos openart.ai et accueil animé">
        <p>
          L'image du T-Rex en hero et les boucles vidéo ont été générées sur
          <a href="https://openart.ai" target="_blank" rel="noopener">openart.ai</a>
          à partir de prompts curés : une dizaine de boucles de T-Rex pour
          l'accueil et les pages, puis, fin mai 2026, deux courtes vidéos pour
          chacune de vingt espèces vedettes, affichées en galerie sur leur
          fiche. Crédits IA du projet : <strong>Claude Code (code) +
          openart.ai (visuels) + llama 3.1 local (résumés)</strong>.
        </p>
        <p>
          Cloudflare Pages refuse tout fichier de plus de 25 MB : les sources
          openart.ai sont ré-encodées en H.264 web par un script ffmpeg du
          dépôt, avec une image fixe en repli. L'accueil reprend le pattern
          temps-driven d'Eywa sans WebGL : un fond qui traverse Trias,
          Jurassique et Crétacé en trois phases de 25 secondes, et un champ de
          poussière ambre en canvas 2D. Un bouton Pause (WCAG 2.2.2) fige les
          vidéos automatiques sur toutes les pages qui en ont ; le choix est
          mémorisé, et en mouvement réduit les vidéos sont figées d'office.
        </p>
      </CaseStudySection>

      <CaseStudySection eyebrow="Ce que Claude Code a fait (et ce que je n'ai pas tapé)">
        <p>
          Comme les autres sites de cette série : <strong>0 ligne de code
          écrite à la main</strong>. Le code Astro / React / CSS, les scripts
          d'import et d'enrichissement, les composants d'accueil, le
          navigateur du codex, la carte, les tokens Tailwind 4 ambre / jade /
          rouille — tout est sorti d'une conversation avec Claude Code.
          Direction artistique et revue côté humain.
        </p>
        <p>
          Depuis octobre 2026, le projet suit <a href="/case-studies/cadence">cadence</a> :
          plan relié aux commits, pages Nouveautés et Plan de travail, revue
          UX de chaque écran (cibles de 44 px, texte de 12 px minimum,
          contrastes), page 404, et une suite de tests navigateur sur le site
          construit. Le 17 novembre 2026, il est passé d'Astro 6 à
          <strong>Astro 7.4</strong> (Vite 8), versions épinglées : le combo
          Tailwind 4 + bundler a déjà cassé le build une fois, et le
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">CLAUDE.md</code>
          du projet interdit de les monter à l'aveugle.
        </p>

        <div class="grid gap-4 sm:grid-cols-2 not-prose pt-2">
          <a
            href="https://github.com/Sylad/evatosorus"
            target="_blank"
            rel="noopener"
            class="rounded-xl border border-white/10 bg-paper-elevated p-5 hover:border-claude/40 transition-colors group"
          >
            <p
              class="font-mono text-xs uppercase tracking-wider text-claude mb-2"
            >
              Repo GitHub
            </p>
            <p class="text-ink group-hover:text-claude-soft transition-colors">
              Sylad/evatosorus ↗
            </p>
            <p class="text-xs text-ink-muted mt-1">
              Public, MIT pour le code
            </p>
          </a>
          <a
            href="https://evatosorus.pages.dev"
            target="_blank"
            rel="noopener"
            class="rounded-xl border border-white/10 bg-paper-elevated p-5 hover:border-claude/40 transition-colors group"
          >
            <p
              class="font-mono text-xs uppercase tracking-wider text-claude mb-2"
            >
              Live
            </p>
            <p class="text-ink group-hover:text-claude-soft transition-colors">
              evatosorus.pages.dev ↗
            </p>
            <p class="text-xs text-ink-muted mt-1">
              Cloudflare Pages, build statique pur
            </p>
          </a>
        </div>
      </CaseStudySection>
    </div>
  </section>
</BaseLayout>
