---
// L8 : un `code` cité dans l'intro devient un vrai <code> (plus d'accents graves bruts).
import { inlineCodeHtml } from "@/lib/inline-code.mjs";
// L106 : « · » lié au mot suivant, jamais seul en fin de ligne.
import { lierPoints } from "@/lib/lier-points.mjs";

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  /** L11 : langue du titre quand elle n'est pas le français (WCAG 3.1.2). */
  titleLang?: string;
  /**
   * L23 : classes de la page posées sur la section, le sur-titre et le chapeau
   * (ex. `news-hero` / `news-eyebrow` / `news-lede`) — les tests et les styles de la
   * page les visent. Le gabarit, lui, ne vit qu'ici : une seule source pour tous les en-têtes.
   */
  class?: string;
  eyebrowClass?: string;
  introClass?: string;
  /**
   * L23 : taille du titre.
   * - `clamped` (défaut, L9) : bornée par la largeur sous 640 px (12vw) ;
   * - `text` (L88, WCAG 1.4.4 / F94) : suit seulement la taille du texte, elle double à 200 % ;
   *   les mots trop longs sont coupés par la césure du site. Nouveautés et Plan de travail
   *   l'ont déjà ; l'étendre aux autres pages change leur rendu à 200 %, c'est un lot à part.
   */
  titleScale?: "clamped" | "text";
  /**
   * L114 : marge du bas réduite sous 640 px (pb-8 au lieu de 5 rem). Pour une page dont l'outil
   * (filtres, liste) doit tenir dans le premier écran du téléphone. Grand écran inchangé.
   */
  compactBottom?: boolean;
}

const { eyebrow, title, intro, titleLang, class: className, eyebrowClass, introClass, titleScale = "clamped", compactBottom = false } = Astro.props;
const titleClass =
  titleScale === "text"
    ? "mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-ink"
    : "mt-3 text-[length:min(2.25rem,max(1.375rem,12vw))] max-sm:leading-(--text-4xl--line-height) sm:text-5xl font-semibold tracking-tight text-ink [overflow-wrap:anywhere]";
---

<section class:list={[className, "relative codex-grid border-b border-white/5"]}>
  <div class:list={["mx-auto max-w-6xl px-borne-5 sm:px-8 pt-20 sm:py-28", compactBottom ? "pb-8" : "pb-20"]}>
    <p class:list={[eyebrowClass, "inline-block max-w-full rounded bg-paper/85 px-2 py-1 font-mono text-xs uppercase tracking-[0.2em] text-claude-soft"]} data-epouse>
      {lierPoints(eyebrow)}
    </p>
    <h1 lang={titleLang} class={titleClass}>
      {title}
    </h1>
    {intro && (
      <p
        class:list={[introClass, "mt-5 max-w-2xl text-base sm:text-lg text-ink leading-relaxed [text-shadow:0_1px_3px_rgb(0_0_0_/0.85)] [&_code]:font-mono [&_code]:text-[0.9em]"]}
        set:html={inlineCodeHtml(intro)}
      />
    )}
  </div>
</section>
