---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import RevueContenu from "@/components/site/RevueContenu.astro";
import VideosCatalog from "@/components/site/VideosCatalog.vue";
import { videoEntries } from "@/data/videos";
---

<BaseLayout
  title="Vidéos"
  description="Sélection de chaînes YouTube et de vidéos qui traitent vraiment de Claude Code — Anthropic, IndyDevDan, Cole Medin, Latent Space, Lenny's Podcast."
>
  <PageHero
    eyebrow="Ressources · Vidéos"
    title="Chaînes et conférences choisies"
    intro="Une courte sélection de chaînes YouTube, conférences et podcasts qui parlent vraiment de Claude Code, des hooks, du MCP et du codage agentique — pas d'influenceurs IA généralistes."
  />

  <div class="mx-auto max-w-6xl px-borne-5 sm:px-8 pt-8">
    <RevueContenu page="videos" />
  </div>

  <section class="mx-auto max-w-6xl px-borne-5 sm:px-8 py-12">
    <VideosCatalog entries={videoEntries} client:load />

    <div
      class="mt-12 rounded-xl border border-claude/20 bg-claude/5 p-borne-6 sm:p-8"
    >
      <h2 class="font-mono text-xs uppercase tracking-wider text-claude mb-3">
        Critères de sélection
      </h2>
      <p class="text-ink leading-relaxed mb-3">
        Pour passer le filtre, une vidéo doit couvrir
        <strong class="text-ink"
          >spécifiquement Claude Code ou l'écosystème immédiat</strong
        > (hooks, MCP, skills, Agent SDK, plugins) — pas une simple comparaison
        entre ChatGPT et Claude ni une réaction d'influenceur IA.
      </p>
      <p class="text-ink-muted leading-relaxed mb-3">
        En <strong class="text-ink">français</strong> : les chaînes listées sont
        des <strong class="text-ink">recommandations personnelles</strong>
        suivies par Sylvain — pas une couverture exhaustive de l'écosystème
        francophone. Le contenu propre à Claude Code en français reste rare ; on
        liste celles qu'on regarde réellement et qui couvrent l'IA pour
        développeurs ou le codage agentique. Une autre chaîne française sérieuse sur Claude Code
        peut être proposée par un ticket
        <a
          href="https://github.com/Sylad/claude-code-codex/issues"
          target="_blank"
          rel="noopener"
          class="text-claude hover:text-claude-soft underline underline-offset-4"
          >sur le dépôt</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>
