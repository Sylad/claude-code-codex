---
// L50 — encadré : une idée à retenir, séparée du fil du texte.
interface Props { titre: string }
const { titre } = Astro.props;
---

<aside data-encadre class="rounded-xl border border-claude/40 bg-paper-elevated p-5 text-sm leading-relaxed">
  <p class="font-mono text-xs uppercase tracking-[0.15em] text-claude mb-2">{titre}</p>
  <div class="text-ink space-y-2"><slot /></div>
</aside>
