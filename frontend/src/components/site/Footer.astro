---
const year = new Date().getFullYear();
// L17 — Nouveautés, Plan de travail et À propos à une action de toute page, à toutes les
// largeurs (« Plan de travail » et « À propos » ne sont pas dans la barre du bureau).
// Espacés par l'écart du flex, sans séparateur : rien d'orphelin quand la rangée passe
// à la ligne à 320 px. Cibles de 44 px.
const siteLinks = [
  { href: "/nouveautes", label: "Nouveautés" },
  { href: "/plan-de-travail", label: "Plan de travail" },
  { href: "/about", label: "À propos" },
];
// Page courante marquée (aria-current + style actif) : rien dans la barre du bureau ne
// l'est sur /plan-de-travail/ ni /about/. Le pied n'est donc plus persisté entre les pages
// (transition:persist) : il est rendu à chaque page avec la bonne adresse.
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<footer class="mt-24 border-t border-white/5 bg-paper">
  <nav aria-label="Le site" class="site-links border-b border-white/5">
    <ul class="mx-auto max-w-6xl px-5 sm:px-8 py-2 flex flex-wrap items-center gap-x-8 gap-y-0 text-sm">
      {siteLinks.map((l) => (
        <li>
          <a
            class:list={[
              "inline-flex items-center min-h-11 underline-offset-4 hover:underline transition-colors",
              isCurrent(l.href) ? "text-claude underline decoration-2" : "text-ink hover:text-claude",
            ]}
            href={l.href}
            aria-current={isCurrent(l.href) ? "page" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="mx-auto max-w-6xl px-5 sm:px-8 py-10 grid gap-6 md:grid-cols-3 text-sm text-ink-muted">
    <div>
      <p class="font-mono text-ink">claude-code-codex</p>
      <p class="mt-1.5 text-xs">
        Codex non-officiel sur Claude Code, l'écosystème Anthropic et
        la collab IA × dev.
      </p>
    </div>

    <div class="flex flex-col items-start">
      <p class="text-xs uppercase tracking-wider text-ink/60 mb-1">Apprendre</p>
      <a class="inline-flex items-center min-h-11 hover:text-ink transition-colors" href="/theory">Théorie</a>
      <a class="inline-flex items-center min-h-11 hover:text-ink transition-colors" href="/ecosystem">Écosystème</a>
      <a class="inline-flex items-center min-h-11 hover:text-ink transition-colors" href="/learning">Learning</a>
      <a class="inline-flex items-center min-h-11 hover:text-ink transition-colors" href="/videos">Vidéos</a>
    </div>

    <div class="flex flex-col items-start md:items-end">
      <p class="text-xs uppercase tracking-wider text-ink/60 mb-1">Liens</p>
      <a
        class="inline-flex items-center min-h-11 hover:text-ink transition-colors"
        href="https://claude.com/claude-code"
        target="_blank"
        rel="noopener"
      >
        Claude Code (Anthropic)
      </a>
      <a
        class="inline-flex items-center min-h-11 hover:text-ink transition-colors"
        href="https://github.com/Sylad/claude-code-codex"
        target="_blank"
        rel="noopener"
      >
        Repo GitHub
      </a>
    </div>
  </div>

  <div class="border-t border-white/5">
    <div
      class="mx-auto max-w-6xl px-5 sm:px-8 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-x-2 text-xs text-ink-muted"
    >
      <p>
        © {year} — codex fan-site, sans affiliation officielle avec
        Anthropic.
      </p>
      <p class="font-mono">
        vibe coded with
        <a
          class="inline-flex items-center min-h-11 text-claude hover:text-claude-soft transition-colors"
          href="https://claude.com/claude-code"
          target="_blank"
          rel="noopener"
        >
          Claude Code
        </a>
      </p>
    </div>
  </div>
</footer>
