---
/*
  Nouveautés — journal des évolutions visibles du site (signature commune des apps, L13).

  Source : docs/nouveautes/*.md, compilé par `cadence news build` (`npm run news`)
  dans public/nouveautes-data/ (nouveautes.json + captures), versionné : Cloudflare
  Pages construit sans cadence. La page est rendue AU BUILD depuis ce JSON, déjà
  trié du plus récent au plus ancien (date, puis heure de création).
*/
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";
import news from "../../public/nouveautes-data/nouveautes.json";

interface NewsEntry {
  slug: string;
  title: string;
  date: string;
  lots: string[];
  captures: string[];
  html: string;
}

const BASE = "/nouveautes-data";
const entries = (news as { entries: NewsEntry[] }).entries;

const formatDate = (day: string) =>
  new Date(`${day}T12:00:00Z`).toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

// Dimensions lues dans l'en-tête PNG (IHDR) : réservent la place des captures,
// pas de saut de mise en page au chargement.
const pngSize = (rel: string) => {
  const buf = readFileSync(join(process.cwd(), "public", "nouveautes-data", rel));
  return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
};
---

<BaseLayout
  title="Nouveautés"
  description="Ce qui a changé sur claude-code-codex, la nouveauté la plus récente en premier."
>
  <section class="news-hero relative codex-grid border-b border-white/5">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-28">
      <p class="news-eyebrow font-mono text-xs uppercase tracking-[0.2em] text-claude">
        Nouveautés
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-ink">
        Ce qui a changé
      </h1>
      <p class="news-lede mt-5 max-w-2xl text-base sm:text-lg text-ink leading-relaxed [text-shadow:0_1px_3px_rgb(0_0_0_/0.85)]">
        Le journal des évolutions du site, la plus récente en premier.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 sm:px-8 py-16">
    {entries.length === 0 ? (
      <p class="text-ink-muted italic">Aucune nouveauté publiée pour l'instant.</p>
    ) : (
      <p class="news-since mb-6 font-mono text-sm text-claude-soft empty:hidden" role="status"></p>
      <ol class="news-list flex flex-col gap-8">
        {entries.map((e) => (
          <li>
            <article
              class="news-entry scroll-mt-20 rounded-xl border border-white/10 bg-paper-elevated p-6 sm:p-8"
              id={e.slug}
              tabindex="-1"
              aria-labelledby={`${e.slug}-titre`}
            >
              <p class="font-mono text-xs uppercase tracking-wider text-claude">
                <time datetime={e.date}>{formatDate(e.date)}</time>
                <span class="news-new-slot"></span>
              </p>
              <h2
                id={`${e.slug}-titre`}
                class="mt-3 text-xl sm:text-2xl font-semibold text-ink [overflow-wrap:anywhere]"
              ><a
                  href={`#${e.slug}`}
                  class="news-permalink"
                  title="Lien vers cette nouveauté (copié au clic)"
                >{e.title}</a></h2>
              <p class="news-link-status font-mono text-xs text-claude-soft empty:hidden mt-1" role="status"></p>
              {/* HTML produit par cadence depuis le Markdown du dépôt. */}
              <div class="news-body mt-4" set:html={e.html} />
              {e.captures.length > 0 && (
                <div class="news-captures mt-6 flex flex-wrap items-start gap-4">
                  {e.captures.map((c, i) => {
                    const { width, height } = pngSize(c);
                    const alt =
                      e.captures.length > 1
                        ? `Capture d'écran ${i + 1} sur ${e.captures.length} : ${e.title}`
                        : `Capture d'écran : ${e.title}`;
                    return (
                      <a
                        href={`${BASE}/${c}`}
                        class="news-capture"
                        data-astro-reload
                        data-width={width}
                        aria-label={`${alt} (agrandir)`}
                        style={`width: min(100%, ${width}px, calc(32rem * ${width} / ${height}))`}
                      >
                        <img
                          src={`${BASE}/${c}`}
                          alt={alt}
                          width={width}
                          height={height}
                          style={`aspect-ratio: ${width} / ${height}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    );
                  })}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    )}
  </section>

  <!-- Visionneuse des captures : « Fermer » hors de la zone qui défile, toujours visible. -->
  <dialog class="news-viewer" aria-label="Capture agrandie">
    <div class="news-viewer-inner">
      <button type="button" class="news-viewer-close" data-close>
        <span aria-hidden="true">✕</span> Fermer
      </button>
      <div
        class="news-viewer-zone"
        role="region"
        tabindex="0"
        aria-label="Capture agrandie, faire défiler pour voir la suite"
      >
        <img alt="" />
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .news-body :global(p) {
    color: var(--color-ink);
    line-height: 1.75;
    margin: 0 0 0.9rem;
  }
  .news-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .news-body :global(ul) {
    margin: 0 0 0.9rem;
    padding-left: 1.3rem;
    list-style: disc;
  }
  .news-body :global(li) {
    color: var(--color-ink);
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }
  .news-body :global(li::marker) {
    color: var(--color-claude);
  }
  .news-body :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .news-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0 0.3em;
    border-radius: 3px;
    background: oklch(1 0 0 / 0.06);
  }
  .news-body :global(a) {
    color: var(--color-claude);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .news-permalink {
    color: inherit;
    text-decoration: none;
  }
  .news-permalink:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: var(--color-claude);
  }
  .news-permalink:hover::after,
  .news-permalink:focus-visible::after {
    content: " #";
    color: var(--color-claude);
  }
  .news-permalink:focus-visible {
    outline: 2px solid var(--color-claude);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .news-entry:focus {
    outline: none;
  }
  /* Entrée visée par le lien permanent : bord orange de la marque. */
  .news-entry.is-target {
    border-color: var(--color-claude);
    box-shadow: 0 0 0 1px var(--color-claude);
  }

  /* Marque « Nouveau » et séparateur « Déjà vu … », posés par le script selon la
     dernière visite (localStorage). */
  .news-list :global(.news-new) {
    margin-left: 0.6rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--color-claude);
    color: var(--color-paper);
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .news-list :global(.news-seen-sep) {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .news-list :global(.news-seen-sep)::before,
  .news-list :global(.news-seen-sep)::after {
    content: "";
    flex: 1;
    border-top: 1px solid oklch(1 0 0 / 0.15);
  }

  /* Taille réservée AVANT chargement (pas de saut de mise en page) : le lien prend
     min(largeur dispo, largeur naturelle, largeur qui donne 32rem de haut), l'image
     le remplit à ses proportions (aspect-ratio en ligne). */
  .news-capture {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    border-radius: 6px;
    line-height: 0;
  }
  .news-capture:focus-visible {
    outline: 2px solid var(--color-claude);
    outline-offset: 3px;
  }
  .news-capture img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid oklch(1 0 0 / 0.12);
    border-radius: 6px;
    cursor: zoom-in;
  }

  .news-viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0.75rem;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .news-viewer::backdrop {
    background: oklch(0.145 0 0 / 0.92);
  }
  .news-viewer-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .news-viewer-close {
    align-self: flex-end;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border-radius: 6px;
    border: 1px solid oklch(1 0 0 / 0.18);
    background: var(--color-paper-elevated);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .news-viewer-close:hover {
    background: var(--color-paper);
  }
  .news-viewer-close:focus-visible,
  .news-viewer-zone:focus-visible {
    outline: 2px solid var(--color-claude);
    outline-offset: 2px;
  }
  .news-viewer-zone {
    min-height: 0;
    max-width: 100%;
    overflow: auto;
    overscroll-behavior: contain;
    border-radius: 6px;
    border: 1px solid oklch(1 0 0 / 0.18);
  }
  /* Téléphone : capture à sa largeur naturelle, au plus deux largeurs d'écran, dans une
     zone qui défile (leçon d'ol-companion L13 : réduite à l'écran, elle est illisible). */
  .news-viewer-zone img {
    display: block;
    height: auto;
    max-width: none;
    width: min(var(--cap-w, 100%), 200vw);
  }
  @media (min-width: 640px) {
    .news-viewer {
      padding: 1.5rem;
    }
    .news-viewer-zone img {
      width: auto;
      max-width: calc(100vw - 3rem - 2px);
      max-height: calc(100dvh - 6.5rem);
    }
  }
</style>

<script>
  import { entryForFragment, permalink } from "@/lib/news-anchor";
  import { NEWS_SEEN_EVENT, browserStorage, isUnseen, markAllSeen, readSeen } from "@/lib/news-badge";

  // Visionneuse des captures. Écoute en phase de capture sur document : passe avant le
  // routeur des transitions Astro et survit aux changements de page (script exécuté
  // une seule fois). Entrée sur le lien déclenche un clic : même chemin qu'à la souris.
  let opener: HTMLElement | null = null;

  function openViewer(link: HTMLAnchorElement) {
    const dialog = document.querySelector<HTMLDialogElement>("dialog.news-viewer");
    const source = link.querySelector("img");
    if (!dialog || !source) return;
    const img = dialog.querySelector("img")!;
    img.src = link.getAttribute("href")!;
    img.alt = source.alt;
    img.style.setProperty("--cap-w", `${link.dataset.width}px`);
    dialog.setAttribute("aria-label", source.alt);
    opener = link;
    document.body.style.overflow = "hidden";
    dialog.showModal();
    dialog.querySelector<HTMLButtonElement>("[data-close]")?.focus();
  }

  document.addEventListener(
    "click",
    (e) => {
      const target = e.target as Element | null;
      if (!target?.closest) return;
      const dialog = target.closest<HTMLDialogElement>("dialog.news-viewer");
      if (dialog) {
        // Bouton « Fermer », ou clic sur le voile (le dialogue lui-même, hors capture).
        if (target.closest("[data-close]") || target === dialog || target.classList.contains("news-viewer-inner")) {
          dialog.close();
        }
        return;
      }
      const link = target.closest<HTMLAnchorElement>("a.news-capture");
      if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      e.stopPropagation();
      openViewer(link);
    },
    true,
  );

  // Échap (natif) ou « Fermer » : la page redéfile et le focus revient à la capture.
  document.addEventListener(
    "close",
    (e) => {
      if (!(e.target as Element).matches?.("dialog.news-viewer")) return;
      document.body.style.overflow = "";
      if (opener?.isConnected) opener.focus();
      opener = null;
    },
    true,
  );

  // Lien permanent (#slug) : le titre met l'ancre dans l'URL (comportement natif du lien),
  // on copie l'URL complète et on l'annonce ; à l'arrivée sur une ancre, l'entrée est
  // signalée et reçoit le focus (le défilement natif tient compte de scroll-margin).
  document.addEventListener("click", async (e) => {
    const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>("a.news-permalink");
    if (!link) return;
    const slug = link.getAttribute("href")!.slice(1);
    const status = document.getElementById(slug)?.querySelector<HTMLElement>(".news-link-status");
    const url = permalink(location.origin, slug);
    try {
      await navigator.clipboard.writeText(url);
      if (status) status.textContent = "Lien copié dans le presse-papiers";
    } catch {
      if (status) status.textContent = "Lien affiché dans la barre d'adresse";
    }
    setTimeout(() => {
      if (status) status.textContent = "";
    }, 4000);
  });

  function revealTarget() {
    const articles = [...document.querySelectorAll<HTMLElement>("article.news-entry")];
    if (!articles.length) return;
    const slug = entryForFragment(location.hash, articles.map((a) => ({ slug: a.id })));
    for (const a of articles) a.classList.toggle("is-target", a.id === slug);
    if (slug) document.getElementById(slug)!.focus({ preventScroll: true });
  }
  document.addEventListener("astro:page-load", revealTarget);

  // Dernière visite (repris d'AetherWX) : « N nouveautés depuis votre dernière visite »,
  // marque « Nouveau » sur ces entrées, séparateur « Déjà vu lors de votre visite du … »
  // avant la première déjà vue ; puis tout est marqué vu et la pastille de la barre s'éteint.
  function markVisit() {
    const list = document.querySelector(".news-list");
    if (!list) return;
    const articles = [...list.querySelectorAll<HTMLElement>("article.news-entry")];
    const entries = articles.map((a) => ({ slug: a.id, date: a.querySelector("time")!.dateTime }));
    const storage = browserStorage();
    const seen = readSeen(storage);
    const fresh = entries.map((e) => isUnseen(e, seen));
    const count = fresh.filter(Boolean).length;

    list.querySelectorAll(".news-seen-sep").forEach((n) => n.remove());
    articles.forEach((a, i) => {
      const slot = a.querySelector(".news-new-slot")!;
      slot.innerHTML = fresh[i] ? '<span class="news-new">Nouveau</span>' : "";
    });
    const since = document.querySelector(".news-since");
    if (since) {
      since.textContent = !count
        ? ""
        : count === 1
          ? "1 nouveauté depuis votre dernière visite"
          : `${count} nouveautés depuis votre dernière visite`;
    }
    const last = fresh.lastIndexOf(true);
    if (seen && last >= 0 && last + 1 < articles.length) {
      const sep = document.createElement("li");
      sep.className = "news-seen-sep";
      // Repère visuel ; la ligne « N nouveautés depuis… » le dit aux lecteurs d'écran.
      sep.setAttribute("aria-hidden", "true");
      sep.textContent = seen.at
        ? `Déjà vu lors de votre visite du ${new Date(seen.at).toLocaleString("fr-FR", { dateStyle: "long", timeStyle: "short" })}`
        : "Déjà vu lors d'une visite précédente";
      articles[last + 1].closest("li")!.before(sep);
    }
    markAllSeen(storage, entries);
    window.dispatchEvent(new Event(NEWS_SEEN_EVENT));
  }
  document.addEventListener("astro:page-load", markVisit);
  window.addEventListener("hashchange", revealTarget);
</script>
