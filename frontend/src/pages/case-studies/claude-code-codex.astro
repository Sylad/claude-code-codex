---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import RetourEtudes from "@/components/site/RetourEtudes.astro";
import MermaidDiagram from "@/components/site/MermaidDiagram.vue";
import CaseStudySection from "@/components/site/CaseStudySection.astro";
import EtudeFraicheur from "@/components/site/EtudeFraicheur.astro";
import { APP_COUNT } from "@/data/apps";

// L39 — état relu le 17 novembre 2026 dans ce dépôt : README, CLAUDE.md, historique git, package.json,
// .github/workflows/batch-update.yml, scripts/lib/claude.ts, scripts/sources/.
const DATE_ETUDE = "2026-11-17";
// Compté au build : toujours juste, sans relevé à refaire. Vite exclut du glob le fichier qui l'appelle,
// d'où le + 1 pour cette page.
const NB_ETUDES = Object.keys(import.meta.glob("./*.astro")).length + 1;
---

<BaseLayout
  title="claude-code-codex (méta)"
  description="Deep dive — ce site lui-même, codex sur Claude Code, construit en pair-programming avec Claude Code (0 ligne de code humaine) : Astro 7 statique, batch hebdo résumé par Claude, plan public et tests sur le site construit."
>
  <PageHero
    eyebrow="Case study · claude-code-codex"
    title="Le codex qui se documente lui-même"
    intro="Ce site a été, à son lancement en mai 2026, la 6e app perso, et reste le projet le plus méta du lot — un codex sur Claude Code, codé en pair-programming avec Claude Code. Il n'est jamais fini : cette page décrit son état réel, relu dans son dépôt."
  />

  <section class="mx-auto max-w-3xl px-borne-5 sm:px-8 py-12 space-y-12">
    <EtudeFraicheur depots={["claude-code-codex"]} date={DATE_ETUDE} />

    <CaseStudySection eyebrow="Pourquoi ce projet">
      <p>
        Au lancement, en mai 2026 : six mois de pair-programming intensif
        avec Claude Code, cinq apps perso en prod, et l'envie d'avoir un endroit pour ranger ce qu'on
        apprend en chemin. Plutôt que d'oublier au fond d'un Notion privé,
        autant en faire un site public.
      </p>
      <p>
        L'objectif est <strong>double</strong>. D'un côté, un codex
        documentaire qui agrège la théorie Claude Code, l'écosystème
        officiel, des études de cas, des sources de veille, des vidéos et des
        guides d'infra tirés du vécu. De l'autre, un banc d'essai personnel
        pour tester les outils tiers (Ruflo a été le premier candidat) et
        capitaliser sur ce qu'on en apprend.
      </p>
      <p>
        Le narratif central est simple :
        <strong>0 ligne de code écrite par l'humain</strong>. C'était le
        cas sur les 6 sites perso au lancement (mai 2026), et c'est ce que
        cette page documente pour le sixième (aujourd'hui {APP_COUNT} apps).
      </p>
    </CaseStudySection>

    <CaseStudySection eyebrow="Architecture">
      <MermaidDiagram
        client:visible
        caption="Statique pur sur Cloudflare Pages, plan et Nouveautés lus au build, batch hebdo via GitHub Actions cron + Anthropic SDK. Aucun backend en prod."
        definition={`flowchart TB
  subgraph REPO["GitHub · Sylad/claude-code-codex (public, MIT)"]
    subgraph FE["frontend/ (Astro 7)"]
      vue["Îlots Vue 3 + reka-ui<br/>Tailwind 4, Mermaid 12"]
      data["data/*.ts — catalogues,<br/>études, livre de bord"]
    end
    plan[".cadence/raf.yaml — plan<br/>docs/nouveautes — journal"]
    subgraph SCR["scripts/ (TypeScript)"]
      batch["batch-update.ts<br/>5 sources"]
    end
  end

  subgraph CI["GitHub Actions (lundi 06h UTC)"]
    cron["cron + workflow_dispatch"]
  end

  subgraph LLM["Anthropic API"]
    claude["claude-haiku-4-5<br/>résumé FR 140 caractères<br/>filtre off-topic"]
  end

  json["data/feeds/*.json"]
  CF["Cloudflare Pages<br/>claude-code-codex-25m.pages.dev"]

  cron --> batch
  batch -->|résumer| claude
  claude --> json
  json -->|commit sur main| REPO
  plan -->|lu au build| FE
  REPO -->|push main, build auto| CF`}
      />
      <p>
        Aucun backend en production. Le site est rendu en statique pur à
        chaque push. Le seul code qui tourne hors build est le job GitHub
        Actions hebdomadaire, qui lit les sources, résume chaque nouveauté
        via Claude et commit les flux JSON sur <code>main</code>.
      </p>
    </CaseStudySection>

    <CaseStudySection eyebrow="Stack & data flow">
      <ul class="list-none space-y-1.5">
        <li>
          <strong>Frontend</strong> — Astro 7.4 (Vite 8), îlots Vue 3 avec
          reka-ui, Tailwind 4, schémas Mermaid 12. Node 22.23.5 épinglé
          (Astro 7 refuse de démarrer sous 22.23.4) ; la montée depuis Astro 6
          date du 17 novembre 2026.
        </li>
        <li>
          <strong>Hébergement</strong> — Cloudflare Pages (build statique,
          CDN edge, build automatique à chaque push sur <code>main</code>)
        </li>
        <li>
          <strong>Batch</strong> — GitHub Actions, cron le lundi à 06h UTC
          + déclenchement à la demande
        </li>
        <li>
          <strong>LLM</strong> — Anthropic SDK avec
          <code>claude-haiku-4-5</code> pour les résumés (140 caractères,
          français, filtre <code>[off-topic]</code>)
        </li>
        <li>
          <strong>Sources lues</strong> — flux Atom de Simon Willison, RSS
          Anthropic (repli gracieux si 404), RSS Human Coders filtré sur
          Claude et Anthropic, API GitHub pour <code>anthropics/skills</code> et
          <code>modelcontextprotocol/servers</code>
        </li>
        <li>
          <strong>Données</strong> — modules TypeScript en source de vérité
          (<code>data/learning.ts</code>, <code>data/ecosystem.ts</code>,
          <code>data/tools-tested.ts</code>, <code>data/livre-de-bord.ts</code>…)
          + flux JSON générés par le batch (<code>data/feeds/*.json</code>)
        </li>
      </ul>
    </CaseStudySection>

    <CaseStudySection eyebrow="Ce que contient le site aujourd'hui">
      <ul class="list-none space-y-1.5">
        <li>
          <strong>Apprendre</strong> — Démarrer (pour les vrais débutants),
          Théorie, Écosystème, Learning (flux de veille), Vidéos, Atelier IA.
        </li>
        <li>
          <strong>Guides</strong> — Kubernetes pour développeurs Java, ArgoCD
          et K8s pour les nuls, Cloudflare pour les nuls : chaque grosse
          galère d'infra devient une page pédagogique une fois résolue.
        </li>
        <li>
          <strong>Études de cas</strong> — {NB_ETUDES} pages : les apps perso,
          des récits transverses (migration K8s en une nuit, encyclopédie
          AetherWX, <a href="/case-studies/cadence">cadence</a>) et les outils
          tiers passés au banc d'essai (section Tools tested).
        </li>
        <li>
          <strong>Suivre le site</strong> —
          <a href="/nouveautes/">Nouveautés</a> (journal des changements
          visibles, pastille « nouveau »),
          <a href="/plan-de-travail/">Plan de travail</a> (généré au build
          depuis le plan, titres publics seulement) et
          <a href="/livre-de-bord/">Livre de bord</a> (une entrée par semaine :
          appris, fabriqué, testé).
        </li>
      </ul>
    </CaseStudySection>

    <CaseStudySection eyebrow="Le process avec Claude Code">
      <p>
        <strong>0 ligne de code humaine.</strong> Le site (et la page que tu
        lis en ce moment) est piloté par instruction conversationnelle. Les
        patterns de collab utilisés concrètement :
      </p>
      <ul class="list-none space-y-1.5">
        <li>
          <strong>Sous-agents en parallèle</strong> via l'outil
          <code>Agent</code> — pour lire les sources, rédiger les sections de
          la page Théorie, ou générer les premières études de cas sans
          étrangler le contexte du parent.
        </li>
        <li>
          <strong>Mémoire persistante</strong> —
          <em>~70 fichiers .md au 8 mai 2026</em> qui capturent les
          décisions, les retours, les patterns gagnants et les anti-patterns
          observés (Ruflo). Rechargés automatiquement à chaque session.
        </li>
        <li>
          <strong>Skills du dépôt</strong> — <code>/sparc</code> et
          <code>/skillify</code> (tirés de Ruflo), <code>/save</code>,
          <code>/test-tool</code> (protocole du banc d'essai),
          <code>/update-rtk-stats</code> et <code>/local</code> (déléguer une
          tâche bornée à un modèle local).
        </li>
        <li>
          <strong>CLAUDE.md de projet</strong> — règles propres au dépôt
          (navigation, Nouveautés, Plan de travail, Livre de bord, filtres de
          ce qui peut être publié), en complément du CLAUDE.md commun.
        </li>
        <li>
          <strong>Depuis septembre 2026 : cadence</strong> — le reste à faire
          vit dans un plan relié aux commits (chaque commit cite son lot),
          chaque écran modifié passe une revue UX à 1440 et 390 px avant
          d'être déclaré fini, et une porte de tests rejoue la suite avant
          chaque livraison.
        </li>
      </ul>
    </CaseStudySection>

    <CaseStudySection eyebrow="Vérifier plutôt que croire">
      <p>
        Un site qui documente des outils vieillit vite. Depuis octobre 2026,
        plusieurs garde-fous tournent à chaque build de tests :
      </p>
      <ul class="list-none space-y-1.5">
        <li>
          <strong>Tests sur le site construit</strong> — une suite
          <code>node --test</code> lit <code>dist</code> et pilote un Chromium
          (barre de navigation mesurée au pixel près à plusieurs tailles de
          police, pages Nouveautés et Plan de travail, absence de tout texte
          privé du plan dans le site).
        </li>
        <li>
          <strong>Relecture de vérité</strong> — chaque affirmation datée ou
          chiffrée du site classée faux, dépassé, non sourcé ou ok ; les
          corrections deviennent des tests.
        </li>
        <li>
          <strong>Études datées</strong> — chaque étude d'une app porte en tête
          sa date de mise à jour et les dépôts qu'elle décrit ; un chiffre
          repris de l'état réel porte sa date et sa source dans la même phrase.
        </li>
        <li>
          <strong>Audit de lisibilité</strong> — repère les pages « mur de
          texte » (mots, schémas, plus long bloc sans intertitre).
        </li>
      </ul>
    </CaseStudySection>

    <CaseStudySection eyebrow="Pivots & lessons learned">
      <ul class="list-none space-y-1.5">
        <li>
          <strong>Émergence du groupe nav "Guides"</strong> — trois
          tutos infra tirés du vécu homelab ont fini par former leur propre
          famille dans la nav. Pattern : la douleur est le sommaire.
        </li>
        <li>
          <strong>Pivot stack Vue (vs React)</strong> — au moment du
          scaffold initial, le mémo de kickoff disait "shadcn-vue" alors
          que les sites cousins avato/evato étaient en React. Vérification
          explicite avant scaffold a évité un coût de pivot tardif.
        </li>
        <li>
          <strong>Ruflo refusé, mais 8 leçons capturées</strong> — le
          test bench Ruflo a échoué sur les blockers (<code>--no-global</code>
          cassé, cleanup incomplet), mais 8 patterns ont été notés et
          deux ont été skillifiés (SPARC, skillify lui-même).
        </li>
        <li>
          <strong>Posture "s'améliorer mutuellement"</strong> — pas de
          verdict binaire adopt/reject sur un outil tiers. Toujours
          extraire les leçons, même quand on rejette le packaging.
        </li>
        <li>
          <strong>Catalogue strict Anthropic-officiel</strong> — la
          tentation d'ajouter Ruflo au catalogue Ecosystem a été
          attrapée à temps. Le site documentaire reste sourcé propre,
          le banc d'essai capture les outils tiers séparément.
        </li>
        <li>
          <strong>Une étude de cas vieillit</strong> — les études des sites
          cousins décrivaient encore, en novembre 2026, un backend et un
          proxy d'images retirés depuis le 1er octobre. D'où la règle : date
          de mise à jour et dépôts décrits en tête de chaque étude.
        </li>
      </ul>
    </CaseStudySection>

    <div class="flex flex-wrap gap-3 pt-4">
      <a
        href="https://github.com/Sylad/claude-code-codex"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded border border-white/10 text-ink-muted hover:text-claude hover:border-claude/40 transition-colors text-sm"
      >
        ↗ GitHub
      </a>
      <a
        href="https://claude-code-codex-25m.pages.dev"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded border border-white/10 text-ink-muted hover:text-claude hover:border-claude/40 transition-colors text-sm"
      >
        ↗ Live
      </a>
      <a
        href="/case-studies/ruflo"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded border border-white/10 text-ink-muted hover:text-claude hover:border-claude/40 transition-colors text-sm"
      >
        → Lire le case study Ruflo
      </a>
    </div>
  </section>
  <RetourEtudes />
</BaseLayout>
