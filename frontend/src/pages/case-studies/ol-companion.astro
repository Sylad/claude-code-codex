---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import RetourEtudes from "@/components/site/RetourEtudes.astro";
import EtudeFraicheur from "@/components/site/EtudeFraicheur.astro";
import MermaidDiagram from "@/components/site/MermaidDiagram.vue";
import CaseStudySection from "@/components/site/CaseStudySection.astro";
---

<BaseLayout
  title="Case study · OL Companion"
  description="OL Companion — compagnon de saison Olympique Lyonnais. React + TanStack côté front, NestJS + crons côté back, push live via SSE depuis 365scores. 100% codé en pair-programming avec Claude Code."
>
  <PageHero
    eyebrow="Case study · ol-companion"
    title="OL Companion"
    intro="Compagnon de saison pour l'Olympique Lyonnais : classement Ligue 1, calendrier (avec abonnement d'agenda), brackets de coupe, live-match avec shot map, carte L1 bicolore. React 18 + TanStack côté front, NestJS 11 + crons côté back, push live via SSE depuis 365scores. 100% du code écrit en pair-programming avec Claude Code (zéro ligne tapée à la main)."
  />

  <section class="mx-auto max-w-3xl px-5 sm:px-8 py-12">
    <div class="space-y-12">
      <EtudeFraicheur depots={[{ nom: "Sylad/ol-companion", href: "https://github.com/Sylad/ol-companion" }]} date="2026-11-22">État relu d'après son README, ses Nouveautés et son plan.</EtudeFraicheur>

      <CaseStudySection eyebrow="Pourquoi cette app">
        <p>
          Suivre l'OL en Ligue 1 sans jongler entre dix sites : un seul écran qui agrège classement,
          forme, prochains matchs, calendrier, brackets de coupe, news communautaires et — le plus
          tendu — un live-match avec shot map quand l'OL joue. L'app tourne sur le cluster k3s de dark-blue
          (namespace <code>preprod</code>, déployée par ArgoCD) et répond sur
          <a class="text-claude hover:underline" href="https://ol.sladoire.dev" target="_blank" rel="noopener">https://ol.sladoire.dev</a> ; elle sert aussi de bac à sable pour la stack <strong>React 18 + Vite +
          TanStack Router/Query + Tailwind</strong> côté front, et <strong>NestJS 11 + crons
          @nestjs/schedule</strong> côté back.
        </p>
        <p>
          Toute la base de code (frontend + backend + Docker + nginx) a été écrite en
          pair-programming avec Claude Code. Sylvain n'a tapé aucune ligne directement : direction
          produit + revues + arbitrages, exécution déléguée à l'agent.
        </p>
      </CaseStudySection>

      <CaseStudySection eyebrow="Architecture">
        <p>
          Trois sources de données externes, agrégées côté backend, mises en cache JSON local,
          poussées en live au frontend via SSE :
        </p>

        <MermaidDiagram
          client:visible
          caption="Frontend React (port 80 du pod) ↔ Backend NestJS (3002) ↔ 3 sources externes. SSE @Sse() pousse les invalidations TanStack Query."
          definition={`flowchart TB
  subgraph FE["Frontend React 18 (port 80 dans le pod)"]
    ui["TanStack Router/Query + Recharts + Leaflet"]
    sse["useEventStream() — EventSource + invalidateQueries"]
  end

  subgraph BE["Backend NestJS 11 (port 3002)"]
    bus["EventBusService — RxJS Subject (signature diff)"]
    sseSvc["@Sse() /api/events — heartbeat 30s"]
    cron["8 services planifiés @Cron (@nestjs/schedule, Paris TZ)"]
    pin["PinGuard (écritures only)"]
    cache["Caches JSON local (data/)"]
    wikiProxy["/api/wiki-image — Fandom/Wiki proxy + cache"]
  end

  subgraph EXT["Sources externes"]
    s365["365scores (LIGUE1=35, OL=465) — classement, saison, live, brackets, shot chart"]
    fdo["football-data.org (teamId=523, compId=2015) — heures des coups d'envoi, .ics, « Ce que ça change »"]
    wiki["Wikipedia FR"]
  end

  ui -->|/api/* via nginx| pin
  pin --> cache
  ui -.->|EventSource /api/events| sseSvc
  cron --> cache
  cron -->|emit on change| bus
  bus --> sseSvc
  sseSvc -.->|push| sse
  cron --> s365
  cron --> fdo
  wikiProxy --> wiki
  ui -->|/api/wiki-image| wikiProxy`}
        />

        <p>
          Front, nginx (port <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">80</code>)
          et back (port <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">3002</code>)
          tournent côte-à-côte dans deux pods du k3s de dark-blue (deux Deployments du chart Helm <code>ol-companion</code>, images GHCR construites par la CI GitHub, tag bumpé dans <code>developpeur-gitops</code> puis synchronisé par ArgoCD ; les caches JSON vivent sur un PVC de 1 Gi).
          nginx proxifie <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/api/</code>
          vers le backend (par son Service Kubernetes), ce qui permet à la SSE de passer sans
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">proxy_buffering</code>
          en plus.
        </p>
      </CaseStudySection>

      <CaseStudySection eyebrow="Pattern phare · SSE → TanStack Query invalidation">
        <p>
          Le morceau de bravoure de l'app, repris ailleurs depuis (cf
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">sse_invalidation_pattern.md</code>).
          Côté backend, un <strong>EventBusService</strong> global expose un
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">Subject&lt;...&gt;</code>
          RxJS. Chaque cron qui poll 365scores diffe sa réponse via une signature courte
          (<code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">[statusGroup, scores, gameTime, events.length, shots.length].join('|')</code>)
          et n'émet sur le bus que si la signature change. Pas de spam, pas de re-render à vide.
        </p>
        <p>
          Un <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">@Sse()</code>
          controller merge le flux du bus avec un heartbeat 30s (sinon proxies/load-balancers
          ferment la connexion idle). Côté front, un seul hook
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">useEventStream()</code>
          monté dans l'AppShell ouvre un
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">EventSource</code>
          et appelle <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">qc.invalidateQueries(...)</code>
          selon le <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">type</code>
          reçu. Les query keys sont structurées en arbre
          (<code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">['live-match']</code> →
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">['live-match', 'stats', gameId, matchupId]</code>),
          donc une seule invalidation root rafraîchit toute la branche.
        </p>
        <p>
          <strong>Filet de sécurité</strong> : les hooks live gardent un
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">refetchInterval: 30_000</code>
          conditionnel (uniquement quand <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">status === 'live'</code>),
          au cas où la SSE tombe. Reconnexion automatique de
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">EventSource</code>
          gère le reste — pas de logique retry à coder.
        </p>
      </CaseStudySection>

      <CaseStudySection eyebrow="Données · 365scores reverse-engineered">
        <p>
          365scores n'a pas d'API publique. Les endpoints utilisés
          (<code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">data.365scores.com/web/standings/</code>,
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">webws.365scores.com/web/game/</code>,
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/web/games/results/</code>,
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/web/games/fixtures/</code>)
          ont été inspectés au devtools. Les premières versions les appelaient en se faisant passer
          pour le site (<code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">X-Domain</code>,
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">Referer</code>, <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">User-Agent</code>
          de navigateur). C'est fini depuis le 20 novembre 2026 : tout appel sortant (365scores,
          football-data, Wikipédia, flux RSS) porte
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">User-Agent: ol-companion/&lt;version&gt; (+https://ol.sladoire.dev)</code>,
          et rien d'autre qui imite un navigateur (règle de Sylvain : aucun contournement anti-robot).
          Mesuré ce jour-là, les six familles d'appels de 365scores répondent 200 sans ces en-têtes ; si
          la source refusait un jour ce client honnête, l'app afficherait son erreur et l'on changerait de
          source. Un test refuse le retour d'un <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">Referer</code>
          ou d'un User-Agent imité.
        </p>
        <p>
          IDs critiques : <strong>Ligue 1</strong> = compétition <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">35</code>,
          <strong>OL</strong> = <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">competitorId=465</code>
          côté 365scores et <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">teamId=523</code>
          côté football-data.org. Le backend remappe 465 → 523 en sortie pour rester compatible
          avec l'historique frontend.
        </p>
        <p>
          <strong>Standings — défense en profondeur</strong>. 365scores publie déjà l'ordre LFP
          officiel (différence générale → buts marqués → face-à-face), mais
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">standings.service.ts</code>
          re-trie localement après fetch, en cas de changement de format upstream. Pas de H2H
          local reconstruit depuis football-data : déjà essayé, ne match jamais ligue1.com.
        </p>
        <p>
          <strong>Évolution du classement, recalculée journée par journée</strong>. Le graphique
          de l'accueil lisait des photos du classement du moment
          (<code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">season-rankings.json</code>),
          prises au fil de l'eau, alors que les clubs n'avaient pas tous joué le même nombre de matchs :
          une journée pouvait y figurer avec une place fausse (4e à la J7 quand l'OL était 1er à l'issue de cette
          journée). Depuis novembre 2026, le backend relit tous les résultats de la Ligue 1 jusqu'à la J1
          et recalcule le classement après chaque journée jouée par l'OL, avec l'ordre officiel de la LFP
          (points, différence de buts, confrontations directes, buts marqués, victoires, victoires à
          l'extérieur), testé sur les vrais résultats de la saison.
        </p>
        <p>
          Pour les logos clubs, l'app combine deux sources : Wikipedia FR via
          <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/api/wiki-image?q=</code>
          (avec mapping statique ID → nom complet du club pour les noms ambigus type "Brest"
          qui retournent la ville plutôt que le club), et le CDN 365scores
          (<code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">imagecache.365scores.com/.../Competitors/&lt;id&gt;</code>)
          pour le classement, le calendrier, le dernier résultat et les popups de la carte L1 : une
          trentaine d'écussons d'un coup via <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/api/wiki-image</code>
          dépassait la limite de débit par visiteur.
        </p>
      </CaseStudySection>

      <CaseStudySection eyebrow="Identité visuelle · rouge & bleu OL, vert sémantique">
        <p>
          La règle palette est verrouillée par le <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">CLAUDE.md</code>
          du projet pour ne pas dériver entre deux sessions. Les couleurs identité OL
          (<span class="text-rose-400">rouge</span> <code class="font-mono text-negative text-[0.9em]">#dc2626</code> /
          <span class="text-blue-400">bleu marine</span> <code class="font-mono text-blue-300 text-[0.9em]">#1e3a8a</code>)
          structurent toute la décoration ; le vert n'apparaît que pour les usages sémantiques
          universels — forme W (vert) / N (jaune) / L (rouge), goal-difference positif, badge
          "Victoire", positions 1-3 LdC dans le tableau.
        </p>
        <p>
          Conséquence concrète : sur le PositionTracker (Recharts), la ligne d'évolution est
          <strong>bleu OL</strong> (pas vert), et le dot du point courant est <strong>rouge OL</strong>.
          Sur la carte Ligue 1, OL est rouge plein ; les moitiés des autres marqueurs disent le résultat de l'OL (bleu OL éclairci = victoire en aplat, gris à barre horizontale = nul, rouge à barre oblique = défaite, gris sombre avec un point = pas encore joué).
          Seule exception : le thème <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/fcnoobz</code>
          (Football Manager save perso) active <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">body.theme-fcnoobz</code>
          qui override en lime + bleu électrique cyberpunk.
        </p>

        <p class="mt-4">Et deux features où Claude Code a livré pile ce qu'il fallait :</p>

        <ul class="space-y-2.5">
          <li class="flex gap-3">
            <span class="mt-2 inline-block w-1 h-1 rounded-full bg-claude shrink-0"></span>
            <span>
              <strong>Brackets de coupe (CdF + EL) qui continuent après élimination OL</strong> —
              <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">bracket.service.ts</code>
              fetch les matchs des autres équipes via
              <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/results/</code> +
              <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/fixtures/</code>
              (l'endpoint racine <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/web/games/?competitions=X</code>
              renvoie 0 — piège vérifié). CdF affichée dès stageNum 6 (1/4), EL dès stageNum 3 (1/8).
              Suivre le parcours adverse même quand l'OL est sorti reste utile : c'est volontaire.
            </span>
          </li>
          <li class="flex gap-3">
            <span class="mt-2 inline-block w-1 h-1 rounded-full bg-claude shrink-0"></span>
            <span>
              <strong>Carte Ligue 1 avec markers bicolores leg-aller/leg-retour</strong> — Leaflet +
              react-leaflet + tuiles OSM, 18 clubs hardcodés
              (<code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">ligue1-clubs-coords.ts</code>).
              Chaque marqueur est un cercle SVG dont la moitié <strong>gauche</strong> représente
              le match aller et la moitié <strong>droite</strong> le retour. Couleur de chaque
              moitié = résultat OL côté concerné. Source = full-season history 365scores. Les 15 clubs
              trop proches (PSG et Paris FC, Monaco et Nice, Lille et Lens, Rennes et Lorient…) sont écartés de quelques
              pixels d'écran, jamais de mètres, d'après une table calculée pour que leurs zones
              cliquables ne se recouvrent à aucun zoom ; l'OL ne bouge jamais.
            </span>
          </li>
        </ul>
      </CaseStudySection>

      <CaseStudySection eyebrow="Depuis mai 2026 · carte L1, Équipe de France, accessibilité">
        <p>
          Les 18 clubs de la <strong>carte Ligue 1</strong> ont une zone cliquable de 24 × 24 px,
          une fiche qui est un vrai dialogue (focus à l'ouverture, Échap pour fermer) et un motif
          blanc par moitié de marqueur (aplat = victoire, barre = nul, oblique = défaite) pour que
          la couleur ne porte jamais seule le résultat. La page <strong>Équipe de France</strong>
          (<code>/equipe-de-france</code>) suit les Bleus avec la même page de match que l'OL
          (en-tête du score, statistiques, momentum, carte des tirs, compositions). Autour : titre de
          page par route, lien d'évitement, pastille d'état du flux temps réel, et une page
          <code>/nouveautes</code> alimentée par les entrées du dépôt.
        </p>
        <p>
          Le match en cours a aussi gagné ses <strong>animations du direct</strong> : un carton rouge déclenche une
          animation rouge, un remplacement la sienne, un but annulé (VAR) une animation dédiée ;
          le poteau n'en a pas. La pastille du direct n'anime son point rouge (ping) que pendant
          un match en cours, et reste neutre et immobile le reste du temps.
        </p>
      <figure class="my-6">
        <img src="/case-studies/ol-companion/01-carte-l1.png" alt="Carte Ligue 1 — 18 clubs, marqueurs bicolores aller et retour avec motifs" class="rounded-lg border border-white/10" loading="lazy" />
        <figcaption class="text-xs text-ink-muted mt-2 font-mono">
          Carte Ligue 1 (L191) — marqueurs bicolores aller / retour, motif blanc par résultat. Capture du 19 octobre 2026.
        </figcaption>
      </figure>
      <figure class="my-6">
        <img src="/case-studies/ol-companion/02-match-bleus.png" alt="Page de match des Bleus — score, statistiques et compositions" class="rounded-lg border border-white/10" loading="lazy" />
        <figcaption class="text-xs text-ink-muted mt-2 font-mono">
          Page de match de l'Équipe de France — même socle que le match de l'OL. Capture du 16 octobre 2026.
        </figcaption>
      </figure>
      </CaseStudySection>

      <CaseStudySection eyebrow="Novembre 2026 · agenda, classement, sources citées">
        <p>
          <strong>S'abonner au calendrier</strong>. Un bouton « S'abonner » de la page Calendrier
          donne l'adresse <code class="font-mono text-claude-soft text-[0.9em] px-1 py-0.5 rounded bg-white/5">/api/calendar.ics</code>
          (Apple Calendrier, Outlook, Google Agenda ou tout agenda qui accepte une adresse). Le flux ne
          contient que la Ligue 1, et ne vient que de football-data.org : les conditions de 365scores
          interdisent de servir ses données à des tiers. Chaque match garde le même identifiant
          d'événement et voit son numéro de révision augmenter quand la Ligue fixe ou déplace l'horaire :
          l'agenda change l'heure au lieu de dupliquer le match. Tant que l'horaire n'est pas fixé, le
          match figure sans heure, sur le week-end prévu. Si la source ne rend aucun match, l'endpoint
          répond 503, jamais un calendrier vide qui effacerait les matchs de l'agenda.
        </p>
        <p>
          <strong>Ce que ça change</strong>. Après un match de Ligue 1 terminé, la carte « Dernier
          résultat » de l'accueil et la page du match disent la place de l'OL avant et après la journée,
          et l'écart avec les places qui comptent (tête, Ligue des champions, Ligue Europa, Ligue
          Conférence, maintien). Le calcul reprend le départage du graphique d'évolution du classement,
          sur les résultats de football-data.org ; tant que des matchs de la journée restent à jouer, le
          bloc est marqué « Provisoire ».
        </p>
        <p>
          <strong>Sources citées</strong>. La mention qu'exige football-data.org (« Football data provided
          by the Football-Data.org API ») s'affiche là où ses données apparaissent : accueil, calendrier,
          carte, page d'un match de Ligue 1 (à venir, ou terminé sous « Ce que ça change ») et À propos. Le bloc « Joueurs en vue » écrit enfin ce
          que compte chaque chiffre de 365scores (« Tacles gagnés par match : 0,1 » au lieu de « Tacles :
          0,1 ») et n'affiche plus un chiffre dont le sens n'est pas établi.
        </p>
        <p>
          <strong>Lisibilité</strong>. Une seule échelle de tailles de texte, en rem, et un plancher de
          12 px mesuré dans Chromium sur toutes les pages à 390 et 1 440 px ; quand le serveur ne répond
          plus, l'accueil n'affiche qu'un « Réessayer » qui relance tout ; au téléphone, la barre du bas
          nomme la page ouverte sous « Plus » et la pastille du direct montre le score et la minute ; les
          lignes d'une formation tiennent chacune sur une ligne, les noms trop larges se coupant en
          syllabes en dernier recours.
        </p>
      <figure class="my-6">
        <img src="/case-studies/ol-companion/03-abonnement-calendrier.png" alt="Page Calendrier à 1440 px : panneau S'abonner ouvert avec les liens Apple Calendrier, Outlook et Google Agenda, l'adresse à copier et la mention de football-data.org" class="rounded-lg border border-white/10" loading="lazy" />
        <figcaption class="text-xs text-ink-muted mt-2 font-mono">
          Abonnement d'agenda (L264) — Ligue 1 seule, d'après football-data.org. Capture du 20 novembre 2026.
        </figcaption>
      </figure>
      <figure class="my-6">
        <img src="/case-studies/ol-companion/04-ce-que-ca-change.png" alt="Carte Dernier résultat de l'accueil, Brest 2-0 Olympique Lyonnais : sous le score, Ce que ça change — Lyon passe de 3e à 5e, à 3 points de la 3e place" class="rounded-lg border border-white/10" loading="lazy" />
        <figcaption class="text-xs text-ink-muted mt-2 font-mono">
          « Ce que ça change » (L265) dans la carte Dernier résultat de l'accueil. Capture du 20 novembre 2026.
        </figcaption>
      </figure>
      </CaseStudySection>

      <article class="space-y-4 pt-2">
        <div
          class="rounded-xl border border-white/10 bg-paper-elevated p-6 sm:p-8"
        >
          <p
            class="font-mono text-xs uppercase tracking-wider text-claude mb-3"
          >
            Stack & crédits
          </p>
          <ul class="text-sm text-ink-muted space-y-1.5 mb-5">
            <li>
              <strong class="text-ink">Frontend</strong> · React 18 · Vite 8 · Vitest 5 · Playwright 1.65 · TanStack Router 1.170
              · TanStack Query 5.107 · Tailwind 3.4 · Recharts 2.15 · Leaflet + react-leaflet ·
              Lucide.
