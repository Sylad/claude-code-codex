---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import EcosystemCatalog from "@/components/site/EcosystemCatalog.vue";
import { ecosystemEntries } from "@/data/ecosystem";

const officialEntries = ecosystemEntries.filter((e) => e.official);
const communityEntries = ecosystemEntries.filter((e) => !e.official);
---

<BaseLayout
  title="Écosystème"
  description="Catalogue triable de plugins, MCP servers, skills et SDKs Claude Code — officiel Anthropic + community testés."
>
  <PageHero
    eyebrow="02 · Écosystème"
    title="Plugins, MCP, skills, SDKs"
    intro="Catalogue des composants officiels (Anthropic + protocole MCP) que tu peux installer pour étendre Claude Code. Filtre par catégorie, recherche, et copie la commande d'install d'un clic."
  />

  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-12">
    <EcosystemCatalog entries={officialEntries} client:load />

    <div
      class="mt-12 rounded-xl border border-claude/20 bg-claude/5 p-6 sm:p-8"
    >
      <p class="font-mono text-xs uppercase tracking-wider text-claude mb-3">
        Critères du catalogue
      </p>
      <p class="text-ink leading-relaxed mb-3">
        Pour rester sourcé propre, ce catalogue ne liste pour l'instant
        que des entrées <strong class="text-ink">officielles Anthropic</strong>
        — plugins de la marketplace
        <a
          href="https://github.com/anthropics/claude-plugins-official"
          target="_blank"
          rel="noopener"
          class="text-claude hover:text-claude-soft underline underline-offset-4"
          >claude-plugins-official</a
        >, skills du dépôt
        <a
          href="https://github.com/anthropics/skills"
          target="_blank"
          rel="noopener"
          class="text-claude hover:text-claude-soft underline underline-offset-4"
          >anthropics/skills</a
        >, serveurs MCP de référence du repo
        <a
          href="https://github.com/modelcontextprotocol/servers"
          target="_blank"
          rel="noopener"
          class="text-claude hover:text-claude-soft underline underline-offset-4"
          >modelcontextprotocol/servers</a
        >, SDK officiels Anthropic, et le protocole MCP lui-même.
      </p>
      <p class="text-ink-muted leading-relaxed text-sm">
        Le batch hebdo enrichira progressivement avec d'autres composants
        publiés via les marketplaces publiques. Si tu vois manquer une
        ressource intéressante, ouvre une issue
        <a
          href="https://github.com/Sylad/claude-code-codex/issues"
          target="_blank"
          rel="noopener"
          class="text-claude hover:text-claude-soft underline underline-offset-4"
          >sur le repo</a
        >.
      </p>
    </div>
  </section>

  {
    communityEntries.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 sm:px-8 pb-16">
        <div class="mb-8 border-t border-white/10 pt-12">
          <p class="font-mono text-xs uppercase tracking-wider text-claude mb-3">
            Section community · soumise au test-tool protocol
          </p>
          <h2 class="text-2xl font-medium text-ink mb-3">
            Skills / plugins community testés
          </h2>
          <p class="text-ink-muted leading-relaxed max-w-3xl">
            Composants <strong class="text-ink">non-officiels</strong>{" "}
            que j'ai passés par mon protocole `/test-tool` (snapshot{" "}
            → install sandbox → diff pollution → smoke test → verdict){" "}
            et pour lesquels la valeur unique vs les skills existantes
            justifie la place. Chaque entrée vient avec son verdict
            détaillé sur la page{" "}
            <a
              href="/case-studies"
              class="text-claude hover:text-claude-soft underline underline-offset-4"
            >
              Tools tested
            </a>
            .
          </p>
        </div>

        <EcosystemCatalog entries={communityEntries} client:load />
      </section>
    )
  }
</BaseLayout>
