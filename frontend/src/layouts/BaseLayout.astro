---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "@/components/site/Navbar.vue";
import Footer from "@/components/site/Footer.astro";
import { adresseFr, alternates, autreLangue, langueDe, traduite } from "@/lib/langues.mjs";
import { libelles } from "@/lib/libelles-site.mjs";
import { BUILD_VERSION } from "@/lib/build-version";
import newsData from "../../public/nouveautes-data/nouveautes.json";

interface Props {
  title: string;
  description?: string;
  /** L28 : page hors index (404) — `noindex`, ni URL canonique ni og:url (elle est servie à n'importe quelle adresse). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title === "claude-code-codex"
  ? title
  : `${title} · claude-code-codex`;
const meta = description ?? "Codex non-officiel sur Claude Code : théorie, écosystème, case studies, ressources et vidéos.";
const pathname = Astro.url.pathname;
// L108 — langue de la page (routage i18n d'Astro : /en/… en anglais, le reste en français) et liens
// hreflang réciproques quand la page a ses deux versions.
const langue = (Astro.currentLocale ?? langueDe(pathname)) === "en" ? "en" : "fr";
const hreflangs = noindex ? [] : alternates(pathname, Astro.site ?? Astro.url);
// L112 — sous /en/, une page sans texte anglais garde son texte français : bandeau « Not translated yet »,
// contenu marqué lang="fr" (WCAG 3.1.2), adresse canonique = la page française (même texte, pas un doublon).
const nonTraduite = langue === "en" && !traduite(pathname);
const canonical = new URL(nonTraduite ? adresseFr(pathname) : pathname, Astro.url);
const autre = autreLangue(pathname);
const bandeau = libelles(langue).nonTraduite;
const ogImage = new URL("/og.svg", Astro.url).toString();
const heroPoster = "/hero-cyberpunk.jpg";
// Index léger (slug + date) pour la pastille « nouveau » du lien Nouveautés (L13).
const newsIndex = newsData.entries.map(({ slug, date }) => ({ slug, date }));
---

<!doctype html>
<html lang={langue} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={meta} />
    <meta name="version" content={BUILD_VERSION} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.toString()} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={meta} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={langue === "en" ? "en_US" : "fr_FR"} />
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <meta property="og:url" content={canonical.toString()} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="claude-code-codex — codex non-officiel sur Claude Code" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={meta} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    {/* L112 (revue UX) : sous /en/, une page sans anglais garde son titre français, marqué comme tel (WCAG 3.1.2) */}
    <title lang={nonTraduite ? "fr" : undefined}>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body class="text-ink min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-claude focus:px-4 focus:py-3 focus:font-medium focus:text-paper"
    >
      {langue === "en" ? "Skip to content" : "Aller au contenu"}
    </a>
    <div
      class="fixed inset-0 -z-10 overflow-hidden pointer-events-none"
      aria-hidden="true"
      transition:persist
    >
      <img
        src={heroPoster}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-center opacity-50"
      />
      {/* L74 — voile du fond fixe : le texte orangé (accent, liens, surtitres de 12 px) passe sur le
           haut de la fenêtre en défilant ; à 70 % il y reste ≥ 4,5:1 (WCAG 1.4.3), mesuré au pire
           pixel autour des lettres sur toutes les pages (tests/l74-contraste-accent.e2e.test.mjs).
           Ne pas l'alléger sans relancer ce test. */}
      <div
        class="absolute inset-0 bg-gradient-to-b from-paper/70 via-paper/75 to-paper/90"
      >
      </div>
    </div>
    {/* L111 : la barre parle la langue de la page (libellés de src/lib/libelles-site.mjs) et marque la rubrique
         de la page française correspondante. Persistée par langue : passer de /x/ à /en/x/ la reconstruit. */}
    {/* L112 (D-6, D-7) : le seul contrôle de langue du site est dans cette barre (`autre` : la même page dans
         l'autre langue) ; plus aucun sélecteur dans les pages. */}
    <Navbar client:load pathname={adresseFr(pathname)} langue={langue} autre={autre} news={newsIndex} transition:persist={`navbar-${langue}`} />
    <main id="main" tabindex="-1" class="flex-1 pt-16 focus:outline-none">
      {nonTraduite ? (
        <>
          <div data-non-traduite class="mx-auto max-w-6xl px-borne-5 sm:px-8 pt-4">
            <p role="note" class="rounded-md border border-claude/40 bg-paper-elevated px-4 py-3 text-sm text-ink">
              <strong class="font-semibold text-claude">{bandeau.titre}</strong> {bandeau.texte}
            </p>
          </div>
          <div lang="fr" data-contenu-fr>
            <slot />
          </div>
        </>
      ) : (
        <slot />
      )}
    </main>
    <Footer />
    <script>
      import { installerCesure } from "@/lib/cesure.mjs";
      import { installerEpouse } from "@/lib/epouser-lignes.mjs";
      // L106 — une pastille de sur-titre sur plusieurs lignes épouse sa ligne la plus longue. Avant la
      // césure : ses rappels passent les premiers, la césure mesure la pastille déjà ajustée.
      installerEpouse();
      // L88 — césure française seulement là où un mot ne tient pas sur sa ligne (WCAG 1.4.10).
      installerCesure();
      // Après une navigation interne (transitions Astro), le focus restait
      // sur le lien cliqué dans la barre persistée ou retombait sur <body> :
      // on le place sur le contenu, comme un chargement complet suivi du
      // lien d'évitement (WCAG 2.4.3).
      document.addEventListener("astro:after-swap", () => {
        if (location.hash) return;
        document.getElementById("main")?.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
