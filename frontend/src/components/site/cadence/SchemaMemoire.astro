---
import Schema from "@/components/site/Schema.astro";
// L108 — schéma « une mémoire en fichiers » de l'étude cadence (L33), partagé par la page française et sa
// traduction (/en/) : le dessin ici, les textes en props (déplacé sans changement).
interface Bloc { qui: string; titre: string; detail: string }
interface Props {
  data: {
    fichiers: { titre: string; code: string; detail: string }[];
    session: Bloc;
    trace: Bloc;
    boucle: string;
  };
  titre: string;
  desc: string;
  legende: string;
}
const { data, titre, desc, legende } = Astro.props;
---

<Schema id="memoire-fichiers" legende={legende}>
  <svg viewBox="0 0 420 340" role="img" aria-labelledby="sch-memoire-fichiers-t sch-memoire-fichiers-d" xmlns="http://www.w3.org/2000/svg">
    <title id="sch-memoire-fichiers-t">{titre}</title>
    <desc id="sch-memoire-fichiers-d">{desc}</desc>
    {data.fichiers.map((f, i) => (
      <>
        <rect class="sch-box" x={16 + 132 * i} y="12" width="124" height="96" rx="10" />
        <text class="sch-t" x={26 + 132 * i} y="36">{f.titre}</text>
        <text class="sch-m sch-mono" x={26 + 132 * i} y="60">{f.code}</text>
        <text class="sch-m" x={26 + 132 * i} y="82">{f.detail}</text>
        <line class="sch-line" x1={78 + 132 * i} y1="108" x2={78 + 132 * i} y2="130" />
        <path class="sch-arrow" d={`M${72 + 132 * i} 128 L${84 + 132 * i} 128 L${78 + 132 * i} 138 Z`} />
      </>
    ))}
    <rect class="sch-box" x="16" y="140" width="388" height="78" rx="10" />
    <text class="sch-a" x="30" y="162">{data.session.qui}</text>
    <text class="sch-t" x="30" y="184">{data.session.titre}</text>
    <text class="sch-m" x="30" y="204">{data.session.detail}</text>
    <line class="sch-line" x1="210" y1="218" x2="210" y2="240" />
    <path class="sch-arrow" d="M204 238 L216 238 L210 248 Z" />
    <rect class="sch-box-accent" x="16" y="250" width="380" height="78" rx="10" />
    <text class="sch-a" x="30" y="272">{data.trace.qui}</text>
    <text class="sch-t" x="30" y="294">{data.trace.titre}</text>
    <text class="sch-m" x="30" y="314">{data.trace.detail}</text>
    <path class="sch-line-accent" d="M396 289 H412 V60 H410" />
    <path class="sch-arrow-accent" d="M413 54 L413 66 L404 60 Z" />
  </svg>
  <div class="sch-liste" data-sch-liste="memoire-fichiers">
    <ul class="sch-suite" aria-label={titre}>
      <li class="sch-etape">
        <ul class="sch-sous">
          {data.fichiers.map((f) => (
            <li>
              <span class="sch-titre">{f.titre}</span>
              <span class="sch-detail sch-mono">{f.code}</span>
              <span class="sch-detail">{f.detail}</span>
            </li>
          ))}
        </ul>
      </li>
      <li class="sch-etape">
        <span class="sch-qui">{data.session.qui}</span>
        <span class="sch-titre">{data.session.titre}</span>
        <span class="sch-detail">{data.session.detail}</span>
      </li>
      <li class="sch-etape sch-etape-accent">
        <span class="sch-qui">{data.trace.qui}</span>
        <span class="sch-titre">{data.trace.titre}</span>
        <span class="sch-detail">{data.trace.detail}</span>
      </li>
    </ul>
    <p class="sch-boucle"><span aria-hidden="true">↺ </span>{data.boucle}</p>
  </div>
</Schema>
