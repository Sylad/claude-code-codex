---
/*
  Nouveautés — journal des évolutions visibles du site (signature commune des apps, L13).

  Source : docs/nouveautes/*.md, compilé par `cadence news build` (`npm run news`)
  dans public/nouveautes-data/ (nouveautes.json + captures), versionné : Cloudflare
  Pages construit sans cadence. La page est rendue AU BUILD depuis ce JSON, déjà
  trié du plus récent au plus ancien (date, puis heure de création).
*/
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDay } from "@/lib/format-date.mjs";
import news from "../../public/nouveautes-data/nouveautes.json";

interface NewsEntry {
  slug: string;
  title: string;
  date: string;
  lots: string[];
  captures: string[];
  html: string;
}

const BASE = "/nouveautes-data";
const entries = (news as { entries: NewsEntry[] }).entries;

// Formateur commun (Nouveautés, séparateur « Déjà vu … », Plan de travail) : « 1er octobre 2026 ».
const formatDate = formatDay;

// Dimensions lues dans l'en-tête PNG (IHDR) : réservent la place des captures,
// pas de saut de mise en page au chargement.
const pngSize = (rel: string) => {
  const buf = readFileSync(join(process.cwd(), "public", "nouveautes-data", rel));
  return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
};
---

<BaseLayout
  title="Nouveautés"
  description="Ce qui a changé sur claude-code-codex, la nouveauté la plus récente en premier."
>
  <section class="news-hero relative codex-grid border-b border-white/5">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-28">
      <p class="news-eyebrow font-mono text-xs uppercase tracking-[0.2em] text-claude">
        Nouveautés
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-ink">
        Ce qui a changé
      </h1>
      <p class="news-lede mt-5 max-w-2xl text-base sm:text-lg text-ink leading-relaxed [text-shadow:0_1px_3px_rgb(0_0_0_/0.85)]">
        Le journal des évolutions du site, la plus récente en premier.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 sm:px-8 py-16">
    {entries.length === 0 ? (
      <p class="text-ink-muted italic">Aucune nouveauté publiée pour l'instant.</p>
    ) : (
      <p class="news-since mb-6 font-mono text-sm text-claude-soft empty:hidden" role="status"></p>
      <p id="news-copy-status" class="sr-only" role="status"></p>
      <ol class="news-list flex flex-col gap-8">
        {entries.map((e) => (
          <li>
            <article
              class="news-entry scroll-mt-20 rounded-xl border border-white/10 bg-paper-elevated p-6 sm:p-8"
              id={e.slug}
              tabindex="-1"
              aria-labelledby={`${e.slug}-titre`}
            >
              {/* L17 (repris d'evatosorus, revue UX L27) : lien permanent par un bouton visible
                  sans survol, après la date et la marque « Nouveau » ; le titre reste du texte
                  (un toucher sur le titre écrasait le presse-papiers et faisait défiler). */}
              <p class="news-date flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs uppercase tracking-wider text-claude">
                <span class="inline-flex items-center"><time datetime={e.date} class="whitespace-nowrap">{formatDate(e.date)}</time><span class="news-new-slot"></span></span>
                <button type="button" class="news-copy" data-slug={e.slug} data-state="idle">
                  <svg class="news-copy-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                  </svg>
                  {/* Les trois libellés partagent la même case : la largeur du plus long est
                      réservée, le retour ne décale rien. */}
                  <span class="news-copy-labels" aria-hidden="true">
                    <span class="news-copy-label" data-for="idle">Copier le lien</span>
                    <span class="news-copy-label is-hidden" data-for="ok">Lien copié</span>
                    <span class="news-copy-label is-hidden" data-for="ko">Copie impossible</span>
                  </span>
                  <span class="sr-only">Copier le lien : {e.title}</span>
                </button>
              </p>
              <h2
                id={`${e.slug}-titre`}
                class="mt-3 text-xl sm:text-2xl font-semibold text-ink [overflow-wrap:anywhere]"
              >{e.title}</h2>
              {/* Copie refusée par le navigateur : l'adresse s'affiche ici, à sélectionner. */}
              <p class="news-link-fallback mt-2 text-sm text-ink-muted [overflow-wrap:anywhere]" hidden>
                Adresse de cette nouveauté&nbsp;: <span class="news-link-url select-all font-mono text-ink"></span>
              </p>
              {/* HTML produit par cadence depuis le Markdown du dépôt. */}
              <div class="news-body mt-4" set:html={e.html} />
              {e.captures.length > 0 && (
                <div class="news-captures mt-6 flex flex-wrap items-start gap-4">
                  {e.captures.map((c, i) => {
                    const { width, height } = pngSize(c);
                    const alt =
                      e.captures.length > 1
                        ? `Capture d'écran ${i + 1} sur ${e.captures.length} : ${e.title}`
                        : `Capture d'écran : ${e.title}`;
                    return (
                      <a
                        href={`${BASE}/${c}`}
                        class="news-capture"
                        data-astro-reload
                        data-width={width}
                        data-height={height}
                        aria-label={`${alt} (agrandir)`}
                        style={`width: min(100%, ${width}px, calc(32rem * ${width} / ${height}))`}
                      >
                        <img
                          src={`${BASE}/${c}`}
                          alt={alt}
                          width={width}
                          height={height}
                          style={`aspect-ratio: ${width} / ${height}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    );
                  })}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    )}
  </section>

  <!-- Visionneuse des captures : « Fermer » hors de la zone qui défile, toujours visible. -->
  <dialog class="news-viewer" aria-label="Capture agrandie">
    <div class="news-viewer-inner">
      <button type="button" class="news-viewer-close" data-close>
        <span aria-hidden="true">✕</span> Fermer
      </button>
      <div
        class="news-viewer-zone"
        role="region"
        tabindex="0"
        aria-label="Capture agrandie, faire défiler pour voir la suite"
      >
        <img alt="" />
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .news-body :global(p) {
    color: var(--color-ink);
    line-height: 1.75;
    margin: 0 0 0.9rem;
  }
  .news-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .news-body :global(ul) {
    margin: 0 0 0.9rem;
    padding-left: 1.3rem;
    list-style: disc;
  }
  .news-body :global(li) {
    color: var(--color-ink);
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }
  .news-body :global(li::marker) {
    color: var(--color-claude);
  }
  .news-body :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .news-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0 0.3em;
    border-radius: 3px;
    background: oklch(1 0 0 / 0.06);
  }
  .news-body :global(a) {
    color: var(--color-claude);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Bouton « Copier le lien » : visible sans survol, cible ≥ 24 px au bureau et ≥ 44 px
     au toucher ; le retour remplace le libellé dans une case de largeur fixe. */
  .news-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.75rem;
    padding: 0.15rem 0.6rem;
    border: 1px solid oklch(0.7 0.15 40 / 0.5);
    border-radius: 6px;
    background: transparent;
    color: var(--color-claude-soft);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
  }
  .news-copy:hover {
    border-color: var(--color-claude);
    background: oklch(0.7 0.15 40 / 0.1);
    color: var(--color-ink);
  }
  .news-copy:focus-visible {
    outline: 2px solid var(--color-claude);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .news-copy {
      min-height: 2.75rem;
      min-width: 2.75rem;
    }
  }
  .news-copy-icon {
    flex: none;
  }
  .news-copy-labels {
    display: inline-grid;
  }
  .news-copy-label {
    grid-area: 1 / 1;
    white-space: nowrap;
  }
  .news-copy-label.is-hidden {
    visibility: hidden;
  }
  .news-entry:focus {
    outline: none;
  }
  /* Entrée visée par le lien permanent : bord orange de la marque. */
  .news-entry.is-target {
    border-color: var(--color-claude);
    box-shadow: 0 0 0 1px var(--color-claude);
  }

  /* Marque « Nouveau » et séparateur « Déjà vu … », posés par le script selon la
     dernière visite (localStorage). */
  .news-list :global(.news-new) {
    margin-left: 0.6rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--color-claude);
    color: var(--color-paper);
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .news-list :global(.news-seen-sep) {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .news-list :global(.news-seen-sep)::before,
  .news-list :global(.news-seen-sep)::after {
    content: "";
    flex: 1;
    border-top: 1px solid oklch(1 0 0 / 0.15);
  }

  /* Taille réservée AVANT chargement (pas de saut de mise en page) : le lien prend
     min(largeur dispo, largeur naturelle, largeur qui donne 32rem de haut), l'image
     le remplit à ses proportions (aspect-ratio en ligne). */
  .news-capture {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    border-radius: 6px;
    line-height: 0;
  }
  .news-capture:focus-visible {
    outline: 2px solid var(--color-claude);
    outline-offset: 3px;
  }
  .news-capture img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid oklch(1 0 0 / 0.12);
    border-radius: 6px;
    cursor: zoom-in;
  }

  .news-viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0.75rem;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .news-viewer::backdrop {
    background: oklch(0.145 0 0 / 0.92);
  }
  .news-viewer-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .news-viewer-close {
    align-self: flex-end;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border-radius: 6px;
    border: 1px solid oklch(1 0 0 / 0.18);
    background: var(--color-paper-elevated);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .news-viewer-close:hover {
    background: var(--color-paper);
  }
  .news-viewer-close:focus-visible,
  .news-viewer-zone:focus-visible {
    outline: 2px solid var(--color-claude);
    outline-offset: 2px;
  }
  .news-viewer-zone {
    min-height: 0;
    max-width: 100%;
    overflow: auto;
    overscroll-behavior: contain;
    border-radius: 6px;
    border: 1px solid oklch(1 0 0 / 0.18);
  }
  /* Téléphone : capture à sa largeur naturelle, au plus deux largeurs d'écran, dans une
     zone qui défile (leçon d'ol-companion L13 : réduite à l'écran, elle est illisible). */
  .news-viewer-zone img {
    display: block;
    height: auto;
    max-width: none;
    width: min(var(--cap-w, 100%), 200vw);
  }
  @media (min-width: 640px) {
    .news-viewer {
      padding: 1.5rem;
    }
    .news-viewer-zone img {
      width: auto;
      max-width: calc(100vw - 3rem - 2px);
      max-height: calc(100dvh - 6.5rem);
    }
    /* Capture qui, entière à l'écran, perdrait plus de 20 % de sa largeur (capture haute
       de téléphone : 241 px sur 390 à 1440×900) : largeur naturelle, la zone défile
       verticalement ; « Fermer » reste hors zone (revue UX L13). */
    .news-viewer[data-mode="natural"] .news-viewer-zone img {
      width: min(var(--cap-w), calc(100vw - 3rem - 2px));
      max-width: none;
      max-height: none;
    }
  }
</style>

<script>
  import { entryForFragment, permalink } from "@/lib/news-anchor";
  import {
    NEWS_SEEN_EVENT, browserStorage, isUnseen, markAllSeen, readSeen, seenSeparatorIndex, seenSeparatorLabel, sinceLabel,
  } from "@/lib/news-badge";

  // Visionneuse des captures. Écoute en phase de capture sur document : passe avant le
  // routeur des transitions Astro et survit aux changements de page (script exécuté
  // une seule fois). Entrée sur le lien déclenche un clic : même chemin qu'à la souris.
  let opener: HTMLElement | null = null;

  function openViewer(link: HTMLAnchorElement) {
    const dialog = document.querySelector<HTMLDialogElement>("dialog.news-viewer");
    const source = link.querySelector("img");
    if (!dialog || !source) return;
    const img = dialog.querySelector("img")!;
    img.src = link.getAttribute("href")!;
    img.alt = source.alt;
    img.style.setProperty("--cap-w", `${link.dataset.width}px`);
    // Échelle si la capture tenait entière à l'écran (bureau) : sous 0,8, largeur naturelle.
    const w = Number(link.dataset.width);
    const h = Number(link.dataset.height);
    const scale = Math.min(1, (innerWidth - 50) / w, (innerHeight - 104) / h);
    if (innerWidth >= 640 && scale < 0.8) dialog.dataset.mode = "natural";
    else delete dialog.dataset.mode;
    dialog.setAttribute("aria-label", source.alt);
    opener = link;
    document.body.style.overflow = "hidden";
    dialog.showModal();
    dialog.querySelector<HTMLButtonElement>("[data-close]")?.focus();
  }

  document.addEventListener(
    "click",
    (e) => {
      const target = e.target as Element | null;
      if (!target?.closest) return;
      const dialog = target.closest<HTMLDialogElement>("dialog.news-viewer");
      if (dialog) {
        // Bouton « Fermer », ou clic sur le voile (le dialogue lui-même, hors capture).
        if (target.closest("[data-close]") || target === dialog || target.classList.contains("news-viewer-inner")) {
          dialog.close();
        }
        return;
      }
      const link = target.closest<HTMLAnchorElement>("a.news-capture");
      if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      e.stopPropagation();
      openViewer(link);
    },
    true,
  );

  // Échap (natif) ou « Fermer » : la page redéfile et le focus revient à la capture.
  document.addEventListener(
    "close",
    (e) => {
      if (!(e.target as Element).matches?.("dialog.news-viewer")) return;
      document.body.style.overflow = "";
      if (opener?.isConnected) opener.focus();
      opener = null;
    },
    true,
  );

  // « Copier le lien » : copie seulement — ni défilement ni changement d'adresse ; retour
  // dans le libellé du bouton (largeur réservée) et annonce pour lecteur d'écran. Copie
  // refusée : l'adresse s'affiche sous le titre, à sélectionner.
  const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
  function setCopyState(btn: HTMLElement, state: "idle" | "ok" | "ko") {
    btn.dataset.state = state;
    btn.querySelectorAll<HTMLElement>(".news-copy-label").forEach((l) => {
      l.classList.toggle("is-hidden", l.dataset.for !== state);
    });
  }
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element | null)?.closest?.<HTMLElement>("button.news-copy");
    if (!btn) return;
    const slug = btn.dataset.slug!;
    const url = permalink(location.origin, slug);
    let ok = true;
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      ok = false;
    }
    setCopyState(btn, ok ? "ok" : "ko");
    const article = document.getElementById(slug);
    const fallback = article?.querySelector<HTMLElement>(".news-link-fallback");
    if (fallback && !ok) {
      fallback.querySelector(".news-link-url")!.textContent = url;
      fallback.hidden = false;
    }
    const status = document.getElementById("news-copy-status");
    if (status) {
      status.textContent = ok
        ? "Lien copié dans le presse-papiers"
        : "Copie impossible : l’adresse est affichée sous le titre";
    }
    clearTimeout(timers.get(btn));
    timers.set(btn, setTimeout(() => {
      setCopyState(btn, "idle");
      if (status) status.textContent = "";
    }, 4000));
  });

  // Arrivée sur /nouveautes/#<slug> (chargement, navigation interne, lien de la même page) :
  // l'entrée est signalée et reçoit le focus ; le défilement natif tient compte de
  // scroll-margin.
  function revealTarget() {
    const articles = [...document.querySelectorAll<HTMLElement>("article.news-entry")];
    if (!articles.length) return;
    const slug = entryForFragment(location.hash, articles.map((a) => ({ slug: a.id })));
    for (const a of articles) a.classList.toggle("is-target", a.id === slug);
    if (slug) document.getElementById(slug)!.focus({ preventScroll: true });
  }
  document.addEventListener("astro:page-load", revealTarget);
  window.addEventListener("hashchange", revealTarget);
  window.addEventListener("popstate", () => setTimeout(revealTarget, 0));
  // Le routeur des transitions Astro traite un lien vers une ancre de la même page par
  // pushState, sans « hashchange » : on relit l'ancre après lui.
  document.addEventListener("click", (e) => {
    const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>("a[href*='#']");
    if (!a) return;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;
    setTimeout(revealTarget, 0);
    setTimeout(revealTarget, 100);
  });

  // Dernière visite (repris d'AetherWX, règles d'evatosorus L27) : « N nouveautés depuis
  // votre dernière visite », marque « Nouveau » sur ces entrées, séparateur avant la
  // première déjà vue si toutes les nouvelles sont au-dessus ; puis tout est marqué vu et
  // la pastille de la barre s'éteint. Premier visiteur : rien n'est marqué nouveau.
  function markVisit() {
    const list = document.querySelector(".news-list");
    if (!list) return;
    const articles = [...list.querySelectorAll<HTMLElement>("article.news-entry")];
    const entries = articles.map((a) => ({ slug: a.id, date: a.querySelector("time")!.dateTime }));
    const storage = browserStorage();
    const seen = readSeen(storage);
    const fresh = entries.map((e) => isUnseen(e, seen));
    const count = fresh.filter(Boolean).length;

    list.querySelectorAll(".news-seen-sep").forEach((n) => n.remove());
    articles.forEach((a, i) => {
      const slot = a.querySelector(".news-new-slot")!;
      slot.replaceChildren();
      if (fresh[i]) {
        const mark = document.createElement("span");
        mark.className = "news-new";
        mark.textContent = "Nouveau";
        slot.append(mark);
      }
    });
    const since = document.querySelector(".news-since");
    if (since) since.textContent = sinceLabel(count, seen);
    const at = seen ? seenSeparatorIndex(fresh) : -1;
    if (at > 0) {
      const sep = document.createElement("li");
      sep.className = "news-seen-sep";
      // Repère visuel ; la ligne « N nouveautés depuis… » le dit aux lecteurs d'écran.
      sep.setAttribute("aria-hidden", "true");
      sep.textContent = seenSeparatorLabel(seen);
      articles[at].closest("li")!.before(sep);
    }
    markAllSeen(storage, entries);
    window.dispatchEvent(new Event(NEWS_SEEN_EVENT));
  }
  document.addEventListener("astro:page-load", markVisit);
</script>
