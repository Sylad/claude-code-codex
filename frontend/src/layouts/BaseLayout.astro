---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "@/components/site/Navbar.vue";
import Footer from "@/components/site/Footer.astro";
import { BUILD_VERSION } from "@/lib/build-version";
import newsData from "../../public/nouveautes-data/nouveautes.json";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title === "claude-code-codex"
  ? title
  : `${title} · claude-code-codex`;
const meta = description ?? "Codex non-officiel sur Claude Code : théorie, écosystème, case studies, ressources et vidéos.";
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.url);
const ogImage = new URL("/og.svg", Astro.url).toString();
const heroPoster = "/hero-cyberpunk.jpg";
// Index léger (slug + date) pour la pastille « nouveau » du lien Nouveautés (L13).
const newsIndex = newsData.entries.map(({ slug, date }) => ({ slug, date }));
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={meta} />
    <meta name="version" content={BUILD_VERSION} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={meta} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="claude-code-codex — codex non-officiel sur Claude Code" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={meta} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body class="text-ink min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-claude focus:px-4 focus:py-3 focus:font-medium focus:text-paper"
    >
      Aller au contenu
    </a>
    <div
      class="fixed inset-0 -z-10 overflow-hidden pointer-events-none"
      aria-hidden="true"
      transition:persist
    >
      <img
        src={heroPoster}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-center opacity-50"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-paper/15 via-paper/55 to-paper/90"
      >
      </div>
    </div>
    <Navbar client:load pathname={pathname} news={newsIndex} transition:persist="navbar" />
    <main id="main" tabindex="-1" class="flex-1 pt-16 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      // Après une navigation interne (transitions Astro), le focus restait
      // sur le lien cliqué dans la barre persistée ou retombait sur <body> :
      // on le place sur le contenu, comme un chargement complet suivi du
      // lien d'évitement (WCAG 2.4.3).
      document.addEventListener("astro:after-swap", () => {
        if (location.hash) return;
        document.getElementById("main")?.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
