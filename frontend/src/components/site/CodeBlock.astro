---
interface Props {
  language: string;
  filename?: string;
  code: string;
  /** Texte en prose (un prompt) : revient à la ligne au lieu de défiler de côté. */
  wrap?: boolean;
}

const { language, filename, code, wrap = false } = Astro.props;
---

<figure class="rounded-lg border border-white/10 bg-paper overflow-hidden my-4">
  <figcaption
    class="flex items-center justify-between px-4 py-2 border-b border-white/5 bg-white/[0.02]"
  >
    <span class="font-mono text-xs text-ink-muted">
      {filename ?? `[${language}]`}
    </span>
    <span class="font-mono text-xs uppercase tracking-wider text-claude">
      {language}
    </span>
  </figcaption>
  <pre
    tabindex={wrap ? undefined : "0"}
    role={wrap ? undefined : "region"}
    aria-label={wrap ? undefined : `Code : ${filename ?? language}`}
    class:list={["px-4 py-3 text-sm leading-relaxed font-mono text-ink/90", wrap ? "whitespace-pre-wrap break-words" : "overflow-x-auto"]}><code>{code}</code></pre>
</figure>
