---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { APP_COUNT } from "@/data/apps";

type SommaireLink = { href: string; label: string };
type SommaireRow = { links: SommaireLink[]; hint: string };

const columns: { eyebrow: string; title: string; rows: SommaireRow[] }[] = [
  {
    eyebrow: "Apprendre",
    title: "Claude Code pas à pas",
    rows: [
      { links: [{ href: "/start", label: "Démarrer" }], hint: "tuto débutant" },
      { links: [{ href: "/theory", label: "Théorie" }], hint: "sous le capot" },
      {
        links: [
          { href: "/atelier-ia", label: "Atelier IA" },
          { href: "/ecosystem", label: "Écosystème" },
        ],
        hint: "outils",
      },
      {
        links: [
          { href: "/learning", label: "Learning" },
          { href: "/videos", label: "Vidéos" },
        ],
        hint: "sources",
      },
    ],
  },
  {
    eyebrow: "Ce que j'ai construit",
    title: "Projets et guides d'infra",
    rows: [
      {
        links: [{ href: "/case-studies", label: "Case studies" }],
        hint: `${APP_COUNT} apps + outils testés`,
      },
      {
        links: [{ href: "/k8s-for-java-developers", label: "K8s pour développeurs Java" }],
        hint: "guide",
      },
      {
        links: [{ href: "/argocd-k8s-pour-les-nuls", label: "ArgoCD + K8s pour les nuls" }],
        hint: "guide",
      },
      {
        links: [{ href: "/cloudflare-pour-les-nuls", label: "Cloudflare pour les nuls" }],
        hint: "guide",
      },
    ],
  },
];
---

<BaseLayout
  title="claude-code-codex"
  description={`Un codex non-officiel sur Claude Code : comment ça marche, l'écosystème, ${APP_COUNT} apps construites avec, et les meilleures sources pour suivre l'évolution.`}
>
  <section class="relative codex-noise overflow-hidden">
    <!-- Hero zone : counter-mask the BaseLayout overlay so the cyberpunk
         video shows through brighter here than on content pages -->
    <div
      class="pointer-events-none absolute inset-0 bg-paper/-50 mix-blend-overlay"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 codex-grid opacity-25"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-claude/20 via-transparent to-transparent"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-paper"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-5 sm:px-8 pt-20 sm:pt-28 pb-12 sm:pb-14">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-claude">
        Codex Claude Code · guides · projets
      </p>
      <h1
        class="mt-4 text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-ink leading-[1.05]"
      >
        Un codex pour comprendre, utiliser<br class="hidden md:inline" />
        et builder avec
        <span class="text-claude">Claude Code</span>.
      </h1>

      <div class="mt-6 flex items-center gap-3.5">
        <span
          class="grid place-items-center shrink-0 w-11 h-11 rounded-full border border-claude/50 bg-paper/80 font-mono text-sm text-claude"
          aria-hidden="true"
        >
          SL
        </span>
        <p class="text-base sm:text-lg text-ink leading-snug">
          Par <strong class="font-semibold">Sylvain Ladoire</strong> —
          développeur Java/web senior
          <span class="block text-sm text-ink-muted">
            {APP_COUNT} applications construites avec Claude Code, déployées
            sur Kubernetes + GitOps
          </span>
        </p>
      </div>

      <p class="mt-5 max-w-2xl text-base sm:text-lg text-ink-muted leading-relaxed">
        Débutant sur Claude Code&nbsp;? <strong class="text-ink">Commence par le tuto</strong>.
        Recruteur ou développeur pressé&nbsp;? Va droit aux projets et aux
        guides Kubernetes.
      </p>

      <!-- Rangée de boutons : flex-wrap, chaque bouton autonome (min 44 px) —
           un bouton de plus s'ajoute ici sans reprise de mise en page. -->
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/start"
          class="inline-flex items-center gap-2 min-h-11 px-5 py-2.5 rounded-md bg-claude text-paper font-medium hover:bg-claude-soft transition-colors motion-safe:active:scale-95"
        >
          Démarrer (débutants) →
        </a>
        <a
          href="/case-studies"
          class="inline-flex items-center gap-2 min-h-11 px-5 py-2.5 rounded-md border border-white/15 bg-paper/80 text-ink hover:bg-paper-elevated transition-colors motion-safe:active:scale-95"
        >
          Voir les projets →
        </a>
        <a
          href="https://github.com/Sylad"
          target="_blank"
          rel="noopener"
          title="Profil GitHub de Sylvain Ladoire — pour me contacter"
          aria-label="GitHub ↗ — profil de Sylvain Ladoire, pour me contacter (nouvel onglet)"
          class="inline-flex items-center gap-2 min-h-11 px-5 py-2.5 rounded-md border border-claude/40 bg-paper/80 text-claude hover:bg-paper-elevated transition-colors motion-safe:active:scale-95"
        >
          GitHub ↗
        </a>
      </div>
    </div>
  </section>

  <nav aria-label="Sommaire" class="mx-auto max-w-6xl px-5 sm:px-8 pb-16">
    <div class="grid gap-4 md:grid-cols-2">
      {columns.map((col) => (
        <div class="rounded-xl border border-white/10 bg-paper-elevated p-5 sm:p-6">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-claude">
            {col.eyebrow}
          </p>
          <h2 class="mt-1.5 mb-2 text-base font-semibold text-ink">
            {col.title}
          </h2>
          <ul>
            {col.rows.map((row) => (
              <li class="flex items-center justify-between gap-4 border-t border-white/5">
                <span class="flex flex-wrap items-center gap-x-2">
                  {row.links.map((l, i) => (
                    <>
                      {i > 0 && <span class="text-ink-muted" aria-hidden="true">·</span>}
                      <a
                        href={l.href}
                        class="inline-flex items-center min-h-11 text-ink hover:text-claude underline-offset-4 hover:underline transition-colors"
                      >
                        {l.label}
                      </a>
                    </>
                  ))}
                </span>
                <span class="text-sm text-ink-muted text-right shrink-0">{row.hint}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </nav>

  <section class="mx-auto max-w-4xl px-5 sm:px-8 py-12">
    <div
      class="rounded-xl border border-claude/20 bg-claude/5 p-6 sm:p-8 text-center"
    >
      <p class="text-sm font-mono uppercase tracking-wider text-claude mb-3">
        Note de l'auteur
      </p>
      <p class="text-ink leading-relaxed">
        Site fan, sans affiliation Anthropic. Sources publiques uniquement.
        Si tu spottes une erreur, ouvre une issue
        <a
          class="text-claude hover:text-claude-soft underline underline-offset-4"
          href="https://github.com/Sylad/claude-code-codex"
          target="_blank"
          rel="noopener"
        >
          sur le repo
        </a>.
      </p>
    </div>
  </section>
</BaseLayout>
