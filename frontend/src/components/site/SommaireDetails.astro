---
/**
 * Sommaire repliable du téléphone et de la tablette (L5 sur /theory, repris par les guides en L9) :
 * la colonne de sommaire n'existe qu'à partir de `masque` (lg = 64em sur /theory, xl = 80em sur les guides).
 */
interface Entree {
  id: string;
  number: string;
  title: string;
}

interface Props {
  entries: Entree[];
  masque: "lg" | "xl";
}

const { entries, masque } = Astro.props;
// Classes écrites en entier : Tailwind ne voit pas une classe composée à l'exécution.
const cache = masque === "lg" ? "lg:hidden" : "xl:hidden";
---

<details
  class:list={["group rounded-lg border border-white/10 bg-paper", cache]}
  data-sommaire-mobile
>
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center px-[min(1rem,16px)] [&::-webkit-details-marker]:hidden font-mono text-xs uppercase tracking-[0.2em] text-ink-muted focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-claude"
  >
    <span aria-hidden="true" class="mr-2 inline-block text-claude transition-transform motion-reduce:transition-none group-open:rotate-90">▸</span>
    Sommaire · {entries.length} sections
  </summary>
  <ol class="border-t border-white/5 px-2 py-2">
    {entries.map((entry) => (
      <li>
        <a
          href={`#${entry.id}`}
          class="flex min-h-11 items-center gap-2 rounded px-2 text-sm text-ink-muted hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-claude"
        >
          {entry.number && <span class="shrink-0 whitespace-nowrap font-mono text-[11px] text-ink/60">{entry.number}</span>}
          <span>{entry.title}</span>
        </a>
      </li>
    ))}
  </ol>
</details>
